local timer_attack_flag = -1;
local traces	= false;

function StealTarget()
end

-- -------------------------------------------------------------------------------
-- When the character is created/loaded
function dummy_OnInit()
	OnInit();
	m_attack_flag = false;
end
AddToVFTable("OnInit", "dummy_OnInit");

-- -------------------------------------------------------------------------------
--
function dummy_OnInitFinal()
	-- Do the Skill to explode
	DoSkill(0);
	--SetProp(GetPyStruct("CharacterProperties", "HP"), ToFixed(0.0));
	if (traces) then Trace("Dummy: Done the skill and set the health to 0! PASSED!"); end
end
AddToVFTable("OnInitFinal", "dummy_OnInitFinal");
-- ----------------------------------------------------------------------------------------------------
function dummy_OnEnemySpotted(enemy)
   -- Detect ennemies
   if (traces) then Trace("An ennemie as been spotted"); end
   enemy:SetTarget(GetSelf());
end
AddToVFTable("OnEnemySpotted", "dummy_OnEnemySpotted");

function dummy_OnTargetInRangedRange()
   -- Detect ennemies
   if (traces) then Trace("An ennemie as been spotted"); end
   enemy:SetTarget(GetSelf());
   timer_attack_flag = StartTimerCB(ATTACK_DELAY, true, StealTargets);
end
AddToVFTable("OnTargetInRangedRange", "dummy_OnTargetInRangedRange");
-- ----------------------------------------------------------------------------------------------------
-- ----------------------------------------------------------------------------------------------------
function Dummy_OnUpdate()
	if (traces) then Trace("Dummy: Being Updated!"); end
-- -- 	DoSkill(0);
end
AddToVFTable("OnUpdate", "Dummy_OnUpdate");
