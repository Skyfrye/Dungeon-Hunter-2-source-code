-- -------------------------------------------------------------------------------
-- Every tick, with the time in seconds since last tick
function OnUpdate(timestamp)
	-- IMPORTANT!
	-- This function won't be called if not re-defined.
	-- You can still put common script inside this function in _commons.lua,
	-- however you will need to overwrite that function and manually call this one.
	--
	-- We had to force the method to be overwritten to be called, because of
	-- a required optimization in code to prevent monsters to call this method
	-- way too often.
end


-- -------------------------------------------------------------------------------
-- Called each time a Timer expires
function OnTimer(timerId)
	local cb_info = TimerEvents[timerId];

	if(cb_info) then
		cb_info.callback(timerId, cb_info.refData);

		-- If it is not a looping timer, then we clear it from the callback list
		if(not cb_info.loop) then
			TimerEvents[timerId] = nil;
		end
	end
end


-- -------------------------------------------------------------------------------
-- Called when an event "ev_" is found in an animation
function OnAnimEvent(ev)
	if (AnimEvents[ev]~=nil) then
	--if (tcallback ~= nil) then
		local tcallback = AnimEvents[ev];
		tcallback.mycallback(ev, tcallback.refData);
	end
end


-- -------------------------------------------------------------------------------
-- When the character's animation is done.
function OnEndOfAnim()
end


