-- 			PlaySound("sfx_spell_lightning_small",false,0,false);
-- 			Trace("SMALL SOUND");
-- 		end 
-- 		if (target_num >= TARGET_MED and target_num < TARGET_HIGH) then
-- 			PlaySound("sfx_spell_lightning_medium",false,0,false);
-- 			Trace("MEDIUM SOUND");
-- 		end
-- 		if (target_num >= TARGET_HIGH) then
-- 			PlaySound("sfx_spell_lightning_big",false,0,false);
-- 			Trace("HIGH SOUND");
-- 		elseif (target_num == 0) then
-- 			PlaySound("StaticBallKilled",false,0,false);
-- 			Trace("NO HIT' FAIL SOUND!");
-- 		end
	end
end

-- ----------------------------------------------------------------------------------------------
local function OnPostSkill_()
end

-- ----------------------------------------------------------------------------------------------
RegisterSkill(OnSkillUpdate_, OnSkillCheck_, OnPreSkill_, OnSkill_, OnPostSkill_, nil, OnSkillInfo_);