-- ----------------------------------------------------------------------------------------------------
-- Madruk Healer Minion Skill: 
-- 
-- - Heals Madruk at regular intervals until the healer's death.
-- ----------------------------------------------------------------------------------------------------


-- ----------------------------------------------------------------------------------------------
-- DATA
-- ----------------------------------------------------------------------------------------------
-- Constants
local RANGE 			= 1000;
local healingAmount		= 10; -- PCT of HP healed each time the skill is used
local targetHPPercentMax	= 100; -- PCT HP threshold (the character will start healing below that value).

local target;
local targetHPCurr;
local targetHPMax;
local targetHPPercentCurr;
local targethealingAmount;


-- ----------------------------------------------------------------------------------------------
-- CALLBACKS
-- ----------------------------------------------------------------------------------------------
-- ----------------------------------------------------------------------------------------------
local function OnSkillUpdate_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillCheck_()
	
	if(not target) then
		SetTargetListCharacterFilter(GetPyCst("AITargetList_CharacterFilter", "Friend"));
		SetTargetListObjectFilter(GetPyCst("AITargetList_ObjectFilter", "NONE"));
		SetTargetListSorting(GetPyCst("AITargetList_Sorting", "NoSort"));
	
		TargetListSearch(RANGE);
		
		if(not IsTargetListEmpty()) then
			target = GetTargetListTop();
			LookAt(target);
		end
		
	else
	
		targetHPCurr, targetHPMax, targetHPPercentCurr = target:GetPropHP();
		
		if(targetHPPercentCurr < targetHPPercentMax) then
			return true, false;
		else
			return false, false;
		end
	
	end
	
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()

	PlayFX(GetPyOID("AnimatedEffectTable", "Madruk_green_faery_cast"));
		
	targethealingAmount = (((targetHPPercentCurr + healingAmount) * targetHPMax) / 100);
	
	if (targethealingAmount > targetHPMax) then
		targethealingAmount = targetHPMax;
	end
	
	target:PlayFX(GetPyOID("AnimatedEffectTable", "Madruk_heal"));
	target:SetProp(GetPyStruct("CharacterProperties", "HP"), ToFixed(targethealingAmount));
	
end

-- ----------------------------------------------------------------------------------------------
local function OnPostSkill_()
end

-- ----------------------------------------------------------------------------------------------
RegisterSkill(OnSkillUpdate_, OnSkillCheck_, OnPreSkill_, OnSkill_, OnPostSkill_);