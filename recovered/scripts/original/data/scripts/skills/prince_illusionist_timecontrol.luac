--[[	Time Control

	Casts a static bubble around the caster that slows enemies and their projectiles

--]]


-- ----------------------------------------------------------------------------------------------
-- DATA
-- ----------------------------------------------------------------------------------------------
-- Constants
local RANGE				= 1000.0;

local BUFF_FX			= GetPyOID("AnimatedEffectTable","spell_dh2_prince_illusionist_timecontrol");
local BUFF_ID			= GetPyOID("ClassTable", "Buff_Illusionist_TimeControl");
local CLASS_ID			= GetPyOID("ClassTable", "Skill_Illusionist_TimeControl");

-- Cached values

local skill_level		= 0;
local mana_cost;

local cooldown;

local buff			= nil;
local traces		= false;

-- ----------------------------------------------------------------------------------------------
-- CALLBACKS
-- ----------------------------------------------------------------------------------------------
local function OnSkillInfo_(slvl)
	SetTempProps(CLASS_ID, slvl);
-- 	if(buff and slvl ~= skill_level) then
-- 		OnSkill_();
-- 	end
	return cooldown;
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillUpdate_()
	local slvl = GetCurrentSkillInfo();

	if(slvl ~= skill_level) then
		skill_level	= slvl;
	end
	SetProp(GetPyStruct("CharacterProperties", "SnS_Level"), ToFixed(skill_level));
	mana_cost	= CalcManaCost(CLASS_ID, slvl);
	cooldown = FromFixed(GetProp(GetPyStruct("CharacterProperties", "SnS_Cooldown"), true));
	if (traces) then Trace("[Skills | Time Control] current value is:"..(cooldown/1000).."seconds of cooldown"); end
	if(cooldown <= 0) then
		cooldown = 6000;
		if (traces) then Trace("[Skills | Time control] Cooldown value failed"); end
	end
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillCheck_()
	return (not HasSkillCooldown() and HasMana(mana_cost)), false;
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()
	SetTargetListCharacterFilter(GetPyCst("AITargetList_CharacterFilter", "Enemy"));
	SetTargetListObjectFilter(GetPyCst("AITargetList_ObjectFilter", "AttackableOnly"));
	SetTargetListSorting(GetPyCst("AITargetList_Sorting", "ClosestFirst"));

	TargetListSearch(RANGE);

	if(not IsTargetListEmpty()) then
		target = GetTargetListTop();
		LookAt(target);
	end
	if (traces) then Trace("[Skills: time control]The skill consumes "..FromFixed(mana_cost).." mana..."); end
	SetSkillCooldown(cooldown);
	UseMana(mana_cost);
end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()
	local bufftime = 4000 + (skill_level*1000); -- Amount of time the slow is active.
	if (traces) then Trace("[Skills | Time Control] OnSkill Event triggered! ") end
	
	PlaySound("sfx_skill_mage_ilu_hold_time_hit",false,0,false);
	
	SetProp(GetPyStruct("CharacterProperties", "SnS_Level"), ToFixed(skill_level));
	ApplyPropClass(CLASS_ID);
	
	TargetListSearch(RANGE);
	repeat
		if(not IsTargetListEmpty()) then
			local target,_,_, character = GetTargetListTop();
			--Debuff_Slow
			if (target ~= nil and character and (not target:IsPlayer()) and (not IsBoss(target)) and (not IsMiniBoss(target))) then
				buff = target:CreateBuff(BUFF_ID, bufftime, false, skill_level, BUFF_FX);
				target:ApplyBuff(BUFF_ID, buff);
			end
			PopTargetList();
		end
	until(IsTargetListEmpty())
end

-- ----------------------------------------------------------------------------------------------
local function OnPostSkill_()
end

-- ----------------------------------------------------------------------------------------------
RegisterSkill(OnSkillUpdate_, OnSkillCheck_, OnPreSkill_, OnSkill_, OnPostSkill_, nil, OnSkillInfo_);