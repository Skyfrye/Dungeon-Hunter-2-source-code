-- ----------------------------------------------------------------------------------------------
-- Sandworm Spit Attack (Based on the swampking attack)
-- ----------------------------------------------------------------------------------------------


-- ----------------------------------------------------------------------------------------------
-- DATA
-- ----------------------------------------------------------------------------------------------
-- Constants
local RANGE 				= FromFixed(GetProp(GetPyStruct("CharacterProperties", "RangeMaxDistance")));
local AOE_RANGE			= 250.0;

local CST_WATER			= GetPyCst("Elemental", "Earth");

local CLASS_ID				= GetPyOID("ClassTable", "WormSkillPoisonAttack");
local AOE_CLASS_ID		= GetPyOID("ClassTable", "WormSkillPoisonAttackAOE");
local PROJECTILE_ID		= GetProp(GetPyStruct("CharacterProperties", "RangeProjectileID"));

local TIMERTRAP_ID		= GetPyOID("TimerTraps", "SandwormSteamCloud");
local TIMERTRAP_DAM_ID	= GetPyOID("GameObjectDamager", "Level01Damage");

local g_target;

-- Cached values


-- ----------------------------------------------------------------------------------------------
-- CALLBACKS
-- ----------------------------------------------------------------------------------------------
-- ----------------------------------------------------------------------------------------------
local function OnSkillInfo_(slvl)
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillUpdate_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillCheck_()
	return true;
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()
	if (HasTarget()) then
		g_target = GetTarget();
		LookAt(g_target);
	end
	
	local dist = FromFixed(GetDistanceBetween(GetName(), g_target:GetName()));
	
	if (dist > RANGE) then
		SetTargetListCharacterFilter(GetPyCst("AITargetList_CharacterFilter", "Enemy"));
		SetTargetListObjectFilter(GetPyCst("AITargetList_ObjectFilter", "NONE"));
		SetTargetListSorting(GetPyCst("AITargetList_Sorting", "FrontalFirst"));
	
		TargetListSearch(RANGE);
	
		if(not IsTargetListEmpty()) then
			g_target = GetTargetListTop();
			LookAt(g_target);
		end
	end
	
end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()
	LookAt(g_target);
	SpawnSkillProjectile(PROJECTILE_ID);
end

-- ----------------------------------------------------------------------------------------------
local function OnDelayedSkill_(target, projectile)
	local x,y,z;

	if(target) then
		x,y,z = target:GetPosition();

		-- The direct damage on the target
		ApplyPropClass(CLASS_ID);
		SkillCombatRoll(target);
		
		SummonTimerTrap(TIMERTRAP_ID, TIMERTRAP_DAM_ID, x, y, z);
	else
		local hack = GetSelf();
		hack._this = projectile;
		x,y,z = hack:GetPosition();
		
		SummonTimerTrap(TIMERTRAP_ID, TIMERTRAP_DAM_ID, x, y, z);
	end

	-- The AoE
	SetTargetListCharacterFilter(GetPyCst("AITargetList_CharacterFilter", "Enemy"));
	SetTargetListObjectFilter(GetPyCst("AITargetList_ObjectFilter", "NONE"));
	SetTargetListSorting(GetPyCst("AITargetList_Sorting", "NoSort"));

	TargetListSearch(AOE_RANGE, 360, x, y, z);

	if(not IsTargetListEmpty()) then
		ApplyPropClass(AOE_CLASS_ID);

		repeat
			local aoe_target = GetTargetListTop();
			PopTargetList();

			if(not target or aoe_target:GetID() ~= target:GetID()) then
				SkillCombatRoll(aoe_target);
			end
		until(IsTargetListEmpty())
	end
end

-- ----------------------------------------------------------------------------------------------
RegisterSkillEx({	update=OnSkillUpdate_,
					check=OnSkillCheck_,
					pre=OnPreSkill_,
					skill=OnSkill_,
					delayed=OnDelayedSkill_,
					info=OnSkillInfo_,
					});