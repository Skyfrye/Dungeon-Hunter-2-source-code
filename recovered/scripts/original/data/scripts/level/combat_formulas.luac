			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Stun_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_stun);
			CF_Trace("	STUN CHANCES = "..tostring(target/256).."\%");
		end

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "SnS_Stun_Target_Chance"));
		if(target>0) then
			target	= target + (attacker:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_stun);
			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Stun_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_stun);
			CF_Trace("	STUN CHANCES = "..tostring(target/256).."\%");
		end
	end

	--CF_Trace("STUN ADUSTED ROLL ="..tostring(target));
	-- RESULT
