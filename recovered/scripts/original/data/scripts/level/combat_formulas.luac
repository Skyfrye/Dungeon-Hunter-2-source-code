	local target = roll-1;	-- default: Don't stun
	local level_difference_to_resist_stun = 5;

	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "Stun_Target_Chance"));
		if(target>0) then
