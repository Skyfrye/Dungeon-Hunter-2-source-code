function CF_CalcFear(roll, attackType)
	if(g_cf_data["attacker"] and g_cf_data["defender"]) then
		return CF__CalcFear(g_cf_data["attacker"], g_cf_data["defender"], roll, attackType);
	else
		Trace("ERROR: No attacker or defender specified");
		return false;
	end
end

function CF_CalcSlow(roll, attackType)
	if(g_cf_data["attacker"] and g_cf_data["defender"]) then
		return CF__CalcSlow(g_cf_data["attacker"], g_cf_data["defender"], roll, attackType);
	else
		Trace("ERROR: No attacker or defender specified");
		return false;
	end
end

function CF_CalcDamage(extraArg, attackType)
	if(g_cf_data["attacker"] and g_cf_data["defender"]) then
		return CF__CalcDamage(	g_cf_data["attacker"], g_cf_data["defender"],
										extraArg, attackType,
										g_cf_data["element"], g_cf_data["offHanded"], g_cf_data["isSkill"]);
	else
		Trace("ERROR: No attacker or defender specified");
		return false;
	end
end
