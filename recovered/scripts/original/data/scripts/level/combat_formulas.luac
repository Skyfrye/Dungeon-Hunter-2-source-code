--[[ Combat Formulas

	IMPORTANT NOTES:
		-	Don't rename the file
		-	Don't rename the core functions. You can add sub functions however.
		-	This is Fixed Point arithmetic (back from the mobile age, ions ago),
			so use the provided functions to multiply or divide the values.
			(Read CommonAPI.txt in data/scripts/)
		-	This file will be included with many different others in the same instance
			of a script, so keep the nomenclature name clash safe, using the prefix "CF"
			for anything that is global.
		-	That file is not "thread safe". This comes from the fact that `attacker`
			and `defender` are set only once before all calculations, to avoid to push
			them on the stack on each function calls.
			(i.e. combat calculations should not be performed in more than one thread.)
--]]

-- ###################################################################################
-- FAST VALUES
-- ###################################################################################
-- Damage
local CP_Damage_Min_Main_Hand	= GetPyStruct("CharacterProperties", "Damage_Min_Main_Hand");
local CP_Damage_Max_Main_Hand	= GetPyStruct("CharacterProperties", "Damage_Max_Main_Hand");
local CP_Damage_Min_Off_Hand	= GetPyStruct("CharacterProperties", "Damage_Min_Off_Hand");
local CP_Damage_Max_Off_Hand	= GetPyStruct("CharacterProperties", "Damage_Max_Off_Hand");
local CP_SnS_MinDamage			= GetPyStruct("CharacterProperties", "SnS_MinDamage");
local CP_SnS_MaxDamage			= GetPyStruct("CharacterProperties", "SnS_MaxDamage");
-- Dots
local CP_Dot_Duration			= GetPyStruct("CharacterProperties", "Dot_Duration");
local CP_Dot_Min_Damage			= GetPyStruct("CharacterProperties", "Dot_Min_Damage");
local CP_Dot_Max_Damage			= GetPyStruct("CharacterProperties", "Dot_Max_Damage");
local CP_SnS_Dot_Duration		= GetPyStruct("CharacterProperties", "SnS_Dot_Duration");
local CP_SnS_Dot_Min_Damage		= GetPyStruct("CharacterProperties", "SnS_Dot_Min_Damage");
local CP_SnS_Dot_Max_Damage		= GetPyStruct("CharacterProperties", "SnS_Dot_Max_Damage");
local CP_SnS_Dot_Elemental_Type	= GetPyStruct("CharacterProperties", "SnS_Dot_Elemental_Type");

-- ###################################################################################
-- ###################################################################################

local g_cf_data = {};	-- Don't touch that. It is used to optimize the calling =]

-- Switch the comment from one line to the other to show traces or disable them
--local CF_Trace = Trace;
local CF_Trace = function() end;



-- ----------------------------------------------------------------------------
-- Must return `true` if the attacker misses the defender, `false` otherwise
-- Must return `true` if the defender dodges the attacker, `false` otherwise
local function CF__CalcMissOrDodge(attacker, defender, roll, attackType, element, offHanded)
	local missAutoMiss	= roll+1;	-- default: Don't auto miss
	local missAutoHit		= roll-1;	-- default: Don't auto hit
	local missTarget		= roll+1;	-- default: Don't miss

	local dodgeRoll		= ToFixed(Rand(0, 100));	-- We need a second roll for dodge
	local dodgeAutoHit	= dodgeRoll-1;					-- default: Don't auto hit
	local dodgeTarget		= dodgeRoll+1;					-- default: Don't dodge



	-- ** STEP 1 - Auto Miss and Auto Hit (Miss) ---------------------
	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		missAutoMiss	= GetPyCst("CombatConstants", "COMBAT_MELEE_AUTOMATIC_MISS_LIMIT");
		missAutoHit		= GetPyCst("CombatConstants", "COMBAT_MELEE_AUTOMATIC_HIT_LIMIT");

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		missAutoMiss	= GetPyCst("CombatConstants", "COMBAT_MAGIC_AUTOMATIC_MISS_LIMIT");
		missAutoHit		= GetPyCst("CombatConstants", "COMBAT_MAGIC_AUTOMATIC_HIT_LIMIT");

	end


	-- RESULT
	if(roll >= missAutoMiss) then
		CF_Trace("\tAttacker automatically misses the defender");
		return true, false;
	elseif(roll < missAutoHit) then
		CF_Trace("\tAttacker automatically hits the defender");
		return false, false;
	end
	-- ** STEP 1 -----------------------------------------------------



	-- ** STEP 2 - Auto Miss (Dodge) ---------------------------------
	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		dodgeAutoHit = GetPyCst("CombatConstants", "COMBAT_MELEE_MAXIMUM_DODGE");

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		-- no auto-hit with dodge roll for magic

	end


	-- RESULT
--	if(dodgeRoll < dodgeAutoHit) then
--		CF_Trace("\tDefender automatically can't block the attacker");
--		return false, false;
--	end
	-- ** STEP 2 -----------------------------------------------------



	-- ** STEP 3 - Miss Calculation ----------------------------------
	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		local attackRating = attacker:GetProp(GetPyStruct("CharacterProperties", "Rating_Attack"));
		attackRating = attackRating + attacker:GetAttackRatingBonus(offHanded);
		local deltaRating = attackRating - defender:GetProp(GetPyStruct("CharacterProperties", "Rating_Defense"));

		missTarget = GetPyCst("CombatConstants", "COMBAT_MELEE_BASE_TO_HIT_CHANCE");
		missTarget = missTarget + MulFixed(deltaRating, GetPyCst("CombatConstants", "COMBAT_MELEE_AR_DR_DIFFERENCE_MODIFIER_TO_HIT"));
		missTarget = missTarget + MulFixed(g_cf_data["ad_dlevel"], GetPyCst("CombatConstants", "COMBAT_MELEE_LEVEL_DIFFERENCE_MODIFIER_TO_HIT"));

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		local attackRating = attacker:GetProp(GetPyStruct("CharacterProperties", "Spell_Rating_Attack"));

		if(element ~= GetPyCst("Elemental", "none")) then
			attackRating = attackRating + attacker:GetProp(GetPyStruct("CharacterProperties", "Spell_Rating_Attack_Bonus_Fire") + element);
		end

		local deltaRating = attackRating - defender:GetProp(GetPyStruct("CharacterProperties", "Spell_Rating_Dodge"));

		missTarget = GetPyCst("CombatConstants", "COMBAT_MAGIC_BASE_TO_HIT_CHANCE");
		missTarget = missTarget + MulFixed(deltaRating, GetPyCst("CombatConstants", "COMBAT_MAGIC_AR_DR_DIFFERENCE_MODIFIER_TO_HIT"));
		missTarget = missTarget + MulFixed(g_cf_data["ad_dlevel"], GetPyCst("CombatConstants", "COMBAT_MAGIC_LEVEL_DIFFERENCE_MODIFIER_TO_HIT"));
	end
	-- ** STEP 3 -----------------------------------------------------



	-- ** STEP 4 - Dodge Calculation ---------------------------------
	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		dodgeTarget = defender:GetProp(GetPyStruct("CharacterProperties", "Rating_Dodge"));
		dodgeTarget = dodgeTarget + MulFixed(g_cf_data["da_dlevel"], GetPyCst("CombatConstants", "COMBAT_MELEE_LEVEL_DIFFERENCE_MODIFIER_TO_DODGE"));

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		-- no dodge for magic

	end
	-- ** STEP 4 -----------------------------------------------------



	-- ** STEP 5 - Final Results -------------------------------------
	if(roll >= missTarget) then
		CF_Trace("\tAttacker misses the defender");
		return true, false;
	end

	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		if(dodgeRoll < dodgeTarget) then
			CF_Trace("\tDefender dodges the attacker");
			return false, true;
		end
	end

	return false, false;
	-- ** STEP 5 -----------------------------------------------------
end


-- ----------------------------------------------------------------------------
-- Must return `true` if the defender blocks the attacker, `false` otherwise
local function CF__CalcBlock(attacker, defender, roll, attackType)
	local target	= roll-1;	-- default: Don't block
	local autoMiss = roll+1;	-- default: Don't auto miss

	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		autoMiss = GetPyCst("CombatConstants", "COMBAT_MELEE_MAXIMUM_BLOCK");

		target = defender:GetProp(GetPyStruct("CharacterProperties", "Rating_Block"));
		target = target + MulFixed(g_cf_data["da_dlevel"], GetPyCst("CombatConstants", "COMBAT_MELEE_LEVEL_DIFFERENCE_MODIFIER_TO_BLOCK"));

		if(defender:HasShield()) then
			target = target + defender:GetProp(GetPyStruct("CharacterProperties", "Rating_Block_Bonus_Shield"));
		end

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then

	end


	-- RESULT
	if(roll >= autoMiss) then
		return false;
	elseif(roll < target) then
		CF_Trace("\tDefender blocks the attacker");
		g_cf_data["isBlocked"] = true;
		return true;
	else
		return false;
	end
end


-- ----------------------------------------------------------------------------
-- Must return `true` if the attacker crits the defender, `false` otherwise
local function CF__CalcCrit(attacker, defender, roll, attackType)
	local target	= roll-1;	-- default: Don't crit
	local autoMiss	= roll+1;	-- default: Don't auto miss

	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		autoMiss	= GetPyCst("CombatConstants", "COMBAT_MELEE_MAXIMUM_CRITICAL");
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "Rating_Critical"));
		target	= target + MulFixed(g_cf_data["ad_dlevel"], GetPyCst("CombatConstants", "COMBAT_MELEE_LEVEL_DIFFERENCE_MODIFIER_TO_CRITICAL"));

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "Spell_Rating_Critical"));
		target	= target + MulFixed(g_cf_data["ad_dlevel"], GetPyCst("CombatConstants", "COMBAT_MAGIC_LEVEL_DIFFERENCE_MODIFIER_TO_CRITICAL"));

	end


	--target = target + attacker:GetCritRatingBonus(offHanded);


	-- RESULT
	if(roll >= autoMiss) then
		return false;
	elseif(roll < target) then
		CF_Trace("\tAttacker crits the defender");
		g_cf_data["isCritical"] = true;
		return true;
	else
		return false;
	end
end


-- ----------------------------------------------------------------------------
-- Must return `true` if the attack hurts the defender, `false` otherwise
local function CF__CalcHurt(attacker, defender, roll, attackType)
	local target = roll-1;	-- default: Don't hurt
	local level_difference_to_resist_hurt = 5;

	CF_Trace("DEFENDER IS:");
	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "Hurt_Target_Chance"));
		if(target>0) then
			target	= target + (attacker:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_hurt);
			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Hurt_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_hurt);
			CF_Trace("	HURT CHANCES = "..tostring(target/256).."\%");
		end
	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "SnS_Hurt_Target_Chance"));
		if(target>0) then
			target	= target + (attacker:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_hurt);
			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Hurt_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_hurt);
			CF_Trace("	HURT CHANCES = "..tostring(target/256).."\%");
		end
	end

	--CF_Trace("HURT ADUSTED ROLL ="..tostring(target));

	-- RESULT
	if(roll < target) then
		CF_Trace("	=> HURTED!!! :"..tostring(roll/256).." < "..tostring(target/256));
		return true;
	else
		CF_Trace("		NOT HURTED!!! :"..tostring(roll/256).." > "..tostring(target/256));
		return false;
	end
end


-- ----------------------------------------------------------------------------
-- Must return `true` if the attack knocks back the defender, `false` otherwise
local function CF__CalcPush(attacker, defender, roll, attackType)
	local target = roll-1;	-- default: Don't knock back
	local level_difference_to_resist_push = 5;

	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "Push_Target_Chance"));
		if(target>0) then
			target	= target + (attacker:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_push);
			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Push_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_push);
			CF_Trace("	PUSH CHANCES = "..tostring(target/256).."\%");
		end

	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "SnS_Push_Target_Chance"));
		if(target>0) then
			target	= target + (attacker:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_push);
			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Push_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_push);
			CF_Trace("	PUSH CHANCES = "..tostring(target/256).."\%");
		end
	end

	--CF_Trace("PUSH ADUSTED ROLL ="..tostring(target));

	-- RESULT
	if(roll < target) then
		CF_Trace("	=> PUSHED!!! :"..tostring(roll/256).." < "..tostring(target/256));
		return true;
	else
		CF_Trace("		NOT PUSH!!! :"..tostring(roll/256).." > "..tostring(target/256));
		return false;
	end
end


