-- ----------------------------------------------------------------------------
-- Must return `true` if the attack slows down the defender, `false` otherwise
local function CF__CalcSlow(attacker, defender, roll, attackType)
	local target = roll-1;	-- default: Don't slow down
	local level_difference_to_resist_slow = 0.125;
	-- MELEE
	if(attackType == GetPyCst("CombatAttackTypes", "Melee")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "Slow_Target_Chance"));
		if(target>0) then
			target	= target + (attacker:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_slow);
			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Slow_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_slow);
			CF_Trace("	SLOW CHANCES = "..tostring(target/256).."%%");
		end


	-- MAGIC
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		target	= attacker:GetProp(GetPyStruct("CharacterProperties", "SnS_Slow_Target_Chance"));
		if(target>0) then
			target	= target + (attacker:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_slow);
			target	= target - defender:GetProp(GetPyStruct("CharacterProperties", "Slow_Resist_Chance"));
			target	= target - (defender:GetProp(GetPyStruct("CharacterProperties", "Level"))*level_difference_to_resist_slow);
			CF_Trace("	SLOW CHANCES = "..tostring(target/256).."%%");
		end
	end

	--CF_Trace("SLOW ADUSTED ROLL ="..tostring(target));


	-- RESULT
	if(roll < target) then
		CF_Trace("	=> SLOWED!!! :"..tostring(roll/256).." < "..tostring(target/256));
		return true;
	else
		CF_Trace("		NOT SLOWED!!! :"..tostring(roll/256).." > "..tostring(target/256));
		return false;
	end
end

-- ----------------------------------------------------------------------------
-- Return the damage made over time
--
local function CF_CalcDotDamage(attacker, defender, isSnS)
	local dotDuration 	= isSnS and attacker:GetProp(CP_SnS_Dot_Duration) or attacker:GetProp(CP_Dot_Duration);
	local dotDamage		= 0;
	local dotElement	= -1;

	if(dotDuration > 0) then
		local minDotDamage = isSnS and attacker:GetProp(CP_SnS_Dot_Min_Damage) or attacker:GetProp(CP_Dot_Min_Damage);
		local maxDotDamage = isSnS and attacker:GetProp(CP_SnS_Dot_Max_Damage) or attacker:GetProp(CP_Dot_Max_Damage);

		-- Integrity check
		if(maxDotDamage < minDotDamage) then
			Trace("ERROR: DoT Max Damage is smaller than Min Damage for : "..tostring(attacker:GetName()));
		end

		dotDamage	= Rand(minDotDamage, maxDotDamage);
		dotElement	= isSnS and FromFixed(attacker:GetProp(CP_SnS_Dot_Elemental_Type)) or GetPyCst("Elemental", "none");

		-- We handle the Bonus and Resistance on the total of the DoT, rather than on each DoT's tick
		if(dotElement ~= GetPyCst("Elemental", "none")) then
			-- We grab the floating value, for more precision
			local absorbPt = defender:GetProp(GetPyStruct("CharacterProperties", "Resistance_Fire") + dotElement);

			-- This was way too powerful, since we can have something like +200 spell damage bonus, and it would add each tick
			-- dotDamage = dotDamage + attacker:GetProp(GetPyStruct("CharacterProperties", "Spell_Damage_Bonus_Fire") + dotElement);
			dotDamage = dotDamage - absorbPt;

			if(dotDamage < 0) then
				dotDamage = 0;
			end
		end
	end
	return dotDuration, dotDamage, dotElement;
end

-- ----------------------------------------------------------------------------
-- The return values depend of the type of attack. Check the comments inside
-- the function for more details.
local function CF__CalcDamage(attacker, defender, extraArg, attackType, element, offHanded, isSkill)
	-- * Melee damages
	-- `extraArg` is not used
	-- `element` is not used
	-- `offHanded` indicates which hand has been used for the attack
	-- `isSkill` indicates if it is a skill requiring melee calculation
	-- Must return the damage after bonus and penalties
	-- Must return the element type
	-- Must return the leech HP
	-- Must return the leech MP
	-- Must return the DoT duration
	-- Must return the DoT damage
	-- Must return the DoT element
	if(attackType == GetPyCst("CombatAttackTypes", "Melee") or attackType == GetPyCst("CombatAttackTypes", "Range")) then
		local minDamage, maxDamage;
		local damage;
		local leechHP, leechMP;
		--local dotDuration, dotDamage, dotElement;

		-- Grab the damage ranges
		if(offHanded) then
			minDamage	= attacker:GetProp(CP_Damage_Min_Off_Hand);
			maxDamage	= attacker:GetProp(CP_Damage_Max_Off_Hand);
			element		= FromFixed(attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Elemental_Type_Off_Hand")));
		else
			minDamage	= attacker:GetProp(CP_Damage_Min_Main_Hand);
			maxDamage	= attacker:GetProp(CP_Damage_Max_Main_Hand);
			element		= FromFixed(attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Elemental_Type_Main_Hand")));
		end

		-- We apply the modification to the basic range if it is a skill
		if(isSkill) then
-- 			minDamage	= minDamage + attacker:GetProp(CP_SnS_MinDamage);
-- 			maxDamage	= maxDamage + attacker:GetProp(CP_SnS_MaxDamage);
			minDamage	= attacker:GetProp(CP_SnS_MinDamage);
			maxDamage	= attacker:GetProp(CP_SnS_MaxDamage);
		end

		-- Integrity check
		if(maxDamage < minDamage) then
			Trace("ERROR: Max Damage is smaller than Min Damage for : "..tostring(attacker:GetName()));
		end

		-- Roll + bonus from specific weapon
		damage = Rand(minDamage, maxDamage);
		damage = damage + attacker:GetDamageBonus(offHanded);

		-- Special bonus: Stunned Defender
		if(defender:GetState() == GetPyCst("AIStates", "Stunned")) then
			damage = damage + attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Bonus_Stunned"));
		end

		-- Special bonus: Stealthed Attacker
		if(attacker:GetProp(GetPyStruct("CharacterProperties", "Special_Sneak")) > defender:GetProp(GetPyStruct("CharacterProperties", "Special_Sneak_Detection"))) then
			damage = damage + attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Bonus_Sneaking"));
		end

		-- Special bonus: Successful Successive Attack
		local hitCount = attacker:GetHitCount();
		if(hitCount > 0) then
			damage = damage + (hitCount * attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Bonus_Combo")));
		end

		-- We apply the block mitigation
		if(g_cf_data["isBlocked"]) then
			damage = MulFixed(damage, defender:GetProp(GetPyStruct("CharacterProperties", "Damage_Block_Mitigation")));
		end

		-- We apply the critical hit bonus
		if(g_cf_data["isCritical"]) then
			damage = damage + maxDamage;
		end

		-- We apply the armor absorbtion
		local armor = defender:GetProp(GetPyStruct("CharacterProperties", "Physical_Armor"));

			--NOTE: this should maybe be a GetArmorBonus(), like bonus for ratings and damages are done
	--	if(defender:HasShield()) then
	--		armor = armor + defender:GetProp(GetPyStruct("CharacterProperties", "Physical_Armor_Bonus_Shield"));
	--	end
	
		CF_Trace("==> damage ========== "..tostring(FromFixed(damage)));
		damage = damage - MulFixed(armor, GetPyCst("CombatConstants", "COMBAT_MELEE_ARMOR_ABSORBTION"));
		CF_Trace("==> ARMOR ========== "..tostring(FromFixed(GetPyCst("CombatConstants", "COMBAT_MELEE_ARMOR_ABSORBTION"))));
		CF_Trace("==> damage ========== "..tostring(FromFixed(damage)));

		-- We make sure the minimum damage of 1 is respected
		if(damage <= 0) then
			damage = ToFixed(1);
		end

		-- We calculate the leeched HP/MP
		leechHP = MulFixed(damage, attacker:GetProp(GetPyStruct("CharacterProperties", "Leech_HP"))) / 100;
		leechMP = MulFixed(damage, attacker:GetProp(GetPyStruct("CharacterProperties", "Leech_MP"))) / 100;

		-- We calculate the elemental damage
		if(element ~= GetPyCst("Elemental", "none")) then
			local minElemDamage, maxElemDamage,ElemdDamage;

			if(offHanded) then
				minElemDamage	= attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Elemental_Min_Off_Hand"));
				maxElemDamage	= attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Elemental_Max_Off_Hand"));
			else
				minElemDamage	= attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Elemental_Min_Main_Hand"));
				maxElemDamage	= attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Elemental_Max_Main_Hand"));
			end

   
		
			if(minElemDamage >= 0 and maxElemDamage >= 0) then
				-- Integrity check
				if(maxElemDamage < minElemDamage) then
					Trace("ERROR: Elemental Max Damage is smaller than Min Damage for : "..tostring(attacker:GetName()));
				end

        		-- Roll + bonus from specific weapon
		    	ElemdDamage = Rand(minElemDamage, maxElemDamage);
				--    ElemdDamage = ElemdDamage + attacker:GetDamageBonus(offHanded);

				-- Failsafe in case of errors
				if (dotElement==nil) then dotElement=0; end
				if (element==nil) then element=0; end
				if (resistPct==nil) then resistPct=0; end
				if (ElemdDamage==nil) then ElemdDamage=0; end
				if (dotDamage==nil) then dotDamage=0; end
				
				
			  	local resistPct = FromFixed(defender:GetProp(GetPyStruct("CharacterProperties", "Resistance_Fire") + element));
			  	resistPct = 1 - (resistPct / 100);

			  	if(resistPct < 0) then		resistPct = 0;
			  	elseif(resistPct > 1) then	resistPct = 1;
			  	end

			  	ElemdDamage = ElemdDamage * resistPct; -- It is a percentage, so we don't have to MulFixed() this line
        		damage = damage + ElemdDamage;

			  	if(damage <= 0) then
			 		damage = ToFixed(1);
			  	end
			  
   			end
		end

		-- We calculate the physical dot (a.k.a. bleeding)
		--dotDuration = attacker:GetProp(GetPyStruct("CharacterProperties", "Dot_Duration"));
		local dotDuration, dotDamage, dotElement = CF_CalcDotDamage(attacker, defender, isSkill);

-- 		if(dotDuration > 0) then
-- 			local minDotDamage = attacker:GetProp(GetPyStruct("CharacterProperties", "Dot_Min_Damage"));
-- 			local maxDotDamage = attacker:GetProp(GetPyStruct("CharacterProperties", "Dot_Max_Damage"));
-- 
-- 			-- Integrity check
-- 			if(maxDotDamage < minDotDamage) then
-- 				Trace("ERROR: DoT Max Damage is smaller than Min Damage for : "..tostring(attacker:GetName()));
-- 			end
-- 
-- 			dotDamage	= Rand(minDotDamage, maxDotDamage);
-- 			dotElement	= GetPyCst("Elemental", "none");
-- 		end
		if (dotDamage==nil) then dotDamage=0; end
		if (damage==nil) then damage=0; end
		if (dotDuration==nil) then dotDuration=0; end
-- 		Trace ("[AI Combat Formulas]Damage:"..FromFixed(damage).." DotDuration:"..FromFixed(dotDuration).." Dot Damage:"..FromFixed(dotDamage));
		return damage, element, leechHP, leechMP, dotDuration, dotDamage, dotElement;


	-- * Magical damages
	-- `extraArg` is not used
	-- `element` indicates the elemental type
	-- `offHanded` is not used
	-- `isSkill` is not used
	-- Must return the damage after bonus and penalties
	elseif(attackType == GetPyCst("CombatAttackTypes", "Magic")) then
		local minDamage, maxDamage;
		if (isSkill) then
			minDamage = attacker:GetProp(GetPyStruct("CharacterProperties", "SnS_MinDamage"));
			maxDamage = attacker:GetProp(GetPyStruct("CharacterProperties", "SnS_MaxDamage"));
		else
			minDamage = attacker:GetProp(CP_Damage_Min_Main_Hand);
			maxDamage = attacker:GetProp(CP_Damage_Max_Main_Hand);
			element		= FromFixed(attacker:GetProp(GetPyStruct("CharacterProperties", "Damage_Elemental_Type_Main_Hand")));
		end
		
		local damage;
		if(minDamage ~= 0 or maxDamage ~= 0) then
			damage = Rand(minDamage, maxDamage);

			-- We apply the elemental bonus and resistance
			if(element ~= GetPyCst("Elemental", "none")) then
				-- We grab the floating value, for more precision
				local _, resistPct = FromFixed(defender:GetProp(GetPyStruct("CharacterProperties", "Resistance_Fire") + element));
				resistPct = 1 - (resistPct / 100);

				if(resistPct < 0) then		resistPct = 0;
				elseif(resistPct > 1) then	resistPct = 1;
				end

				damage = damage + attacker:GetProp(GetPyStruct("CharacterProperties", "Spell_Damage_Bonus_Fire") + element);
				damage = damage * resistPct; -- It is a percentage, so we don't have to MulFixed() this line

				if(damage <= 0) then
					damage = ToFixed(1);
				end
			end

			-- We apply the bonus for a critical hit
			if(g_cf_data["isCritical"]) then
				damage = damage + maxDamage;
			end

			-- We apply the absorbtion from the magical armor
			CF_Trace("==> damage ========== "..tostring(FromFixed(damage)));
			damage = damage - MulFixed(defender:GetProp(GetPyStruct("CharacterProperties", "Magical_Armor")), GetPyCst("CombatConstants", "COMBAT_MAGIC_ARMOR_ABSORBTION"));
			CF_Trace("==> MAGICAL ARMOR ========== "..tostring(FromFixed(GetPyCst("CombatConstants", "COMBAT_MELEE_ARMOR_ABSORBTION"))));
			CF_Trace("==> damage ========== "..tostring(FromFixed(damage)));

			-- We check for a minimum damage
			if(damage <= 0) then
				damage = ToFixed(1);
			end
		else
		    damage = 0;
		end
		
		-- We calculate the dot
		local dotDuration = 0;
		local dotDamage = 0;
		local dotElement = 0;
		if(isSkill) then
			dotDuration, dotDamage, dotElement = CF_CalcDotDamage(attacker, defender, true);
			if (dotDuration==nil) then dotDuration=0; end
			if (dotDuration>0) then
				Trace ("");
				Trace ("-----------------------------------------------");
				Trace ("--  COMBAT FORMULAT SKILL DOT CALCULATION    --");
				Trace ("-----------------------------------------------");
				Trace ("Current attacker:"..attacker:GetName());
				Trace ("Current Dot Duration:"..FromFixed(dotDuration));
				Trace ("Current Dot Damage:"..FromFixed(dotDamage));
				Trace ("-----------------------------------------------");
				Trace ("");
			end
		end

		-- Results
		CF_Trace("==> MAGIC DAMAGE = "..tostring(FromFixed(damage)));
		--Trace ("[AI Combat Formulas]Damage:"..FromFixed(damage).." DotDuration:"..FromFixed(dotDuration).." Dot Damage:"..FromFixed(dotDamage));
		return damage, nil, nil, nil, dotDuration, dotDamage, dotElement;

--		-- Range Type Combat tick
	elseif(attackType == GetPyCst("CombatAttackTypes", "Dot")) then
		local damage = extraArg;
		--NOTE:	We handle the Bonus and Resistance on the total of the DoT, rather than on each DoT's tick
		--		(Check SF_CalcDotDamage for the calculation)
		Trace("==> DOT DAMAGE DONE = "..tostring(damage/256));
		return damage;
	end
end



-- ******************************************************************************************* --
-- ** Don't touch those                                                                     ** --
-- ******************************************************************************************* --
function CF_SetCombatants(attacker, defender, elementalType, offHanded, isSkill)
	g_cf_data["attacker"]	= attacker;
	g_cf_data["defender"]	= defender;
	g_cf_data["ad_dlevel"]	= attacker:GetProp(GetPyStruct("CharacterProperties", "Level")) - defender:GetProp(GetPyStruct("CharacterProperties", "Level"));
	g_cf_data["da_dlevel"]	= -g_cf_data["ad_dlevel"];
	g_cf_data["element"]		= elementalType;
	g_cf_data["offHanded"]	= offHanded;
	g_cf_data["isSkill"]		= isSkill;

	CF_Trace("COMBAT: Attacker="..tostring(attacker:GetName()).." | Defender="..tostring(defender:GetName()));
end

function CF_ClearCombatants()
	g_cf_data = {};
end


function CF_CalcMissOrDodge(roll, attackType)
	if(g_cf_data["attacker"] and g_cf_data["defender"]) then
		return CF__CalcMissOrDodge(g_cf_data["attacker"], g_cf_data["defender"], roll, attackType, g_cf_data["element"], g_cf_data["offHanded"]);
	else
		Trace("ERROR: No attacker or defender specified");
		return false, false;
	end
end

function CF_CalcDodge(roll, attackType)
	if(g_cf_data["attacker"] and g_cf_data["defender"]) then
		return CF__CalcDodge(g_cf_data["attacker"], g_cf_data["defender"], roll, attackType);
	else
		Trace("ERROR: No attacker or defender specified");
		return false;
	end
end


function CF_CalcBlock(roll, attackType)
	if(g_cf_data["attacker"] and g_cf_data["defender"]) then
		return CF__CalcBlock(g_cf_data["attacker"], g_cf_data["defender"], roll, attackType);
