<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="data_downloader_title_text_default_style" parent="">
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="data_downloader_button_text_default_style" parent="">
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="data_downloader_main_text_image_color" parent="">
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">normal</item>
        <item name="android:background">#77ffffff</item>
    </style>
    <style name="data_downloader_progress_text_extra_style" parent="">
        <item name="android:typeface">normal</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="data_downloader_title_layout" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/data_downloader_title_height</item>
    </style>
    <style name="data_downloader_title_background_style" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:adjustViewBounds">true</item>
    </style>
    <style name="data_downloader_title_logo_style" parent="">
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:paddingLeft">@dimen/data_downloader_title_logo_paddingLeft</item>
        <item name="android:paddingTop">@dimen/data_downloader_title_logo_paddingTop</item>
        <item name="android:paddingRight">@dimen/data_downloader_title_logo_paddingRight</item>
        <item name="android:paddingBottom">@dimen/data_downloader_title_logo_paddingBottom</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:adjustViewBounds">true</item>
    </style>
    <style name="data_downloader_title_text_style" parent="@style/data_downloader_title_text_default_style">
        <item name="android:textSize">@dimen/data_downloader_title_text_size</item>
        <item name="android:textColor">@color/data_downloader_title_text_color</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="data_downloader_title_included" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/data_downloader_title_height</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:layout_below">@id/buttonsLayout</item>
        <item name="android:layout_alignParentLeft">true</item>
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="android:layout_alignParentBottom">false</item>
        <item name="android:layout_centerHorizontal">false</item>
        <item name="android:layout_centerVertical">false</item>
    </style>
    <style name="data_downloader_buttons_root_layout_style" parent="">
        <item name="android:background">@drawable/data_downloader_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
    <style name="data_downloader_button_style" parent="@style/data_downloader_button_text_default_style">
        <item name="android:textSize">@dimen/data_downloader_button_text_size</item>
        <item name="android:textColor">@color/data_downloader_button_text_color</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/data_downloader_button_selector</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">@dimen/data_downloader_button_width</item>
        <item name="android:maxHeight">@dimen/data_downloader_button_height</item>
        <item name="android:minWidth">@dimen/data_downloader_button_width</item>
        <item name="android:minHeight">@dimen/data_downloader_button_height</item>
    </style>
    <style name="data_downloader_frame_button_style" parent="">
        <item name="android:layout_gravity">bottom</item>
        <item name="android:paddingLeft">@dimen/data_downloader_button_padding_left</item>
        <item name="android:paddingTop">@dimen/data_downloader_button_padding_top</item>
        <item name="android:paddingRight">@dimen/data_downloader_button_padding_right</item>
        <item name="android:paddingBottom">@dimen/data_downloader_button_padding_bottom</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="data_downloader_buttons_layout_style" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
    <style name="data_downloader_buttons_frame_layout_style" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentLeft">true</item>
        <item name="android:layout_alignParentTop">false</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="android:layout_alignParentBottom">true</item>
        <item name="android:layout_centerHorizontal">false</item>
        <item name="android:layout_centerVertical">false</item>
    </style>
    <style name="data_downloader_frame_main_text_style" parent="">
        <item name="android:paddingLeft">@dimen/data_downloader_main_text_frame_padding_side</item>
        <item name="android:paddingTop">@dimen/data_downloader_main_text_frame_padding_top</item>
        <item name="android:paddingRight">@dimen/data_downloader_main_text_frame_padding_side</item>
        <item name="android:paddingBottom">@dimen/data_downloader_main_text_frame_padding_top</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_above">@id/buttonsLayout</item>
        <item name="android:layout_below">@id/titleLayout</item>
        <item name="android:layout_alignParentLeft">true</item>
        <item name="android:layout_alignParentTop">false</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="android:layout_alignParentBottom">false</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:layout_centerVertical">true</item>
    </style>
    <style name="data_downloader_main_text_background_frame" parent="">
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="data_downloader_main_text_background_frame2" parent="">
        <item name="android:layout_gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="data_downloader_main_text" parent="@style/data_downloader_main_text_image_color">
        <item name="android:textSize">@dimen/data_downloader_main_text_size</item>
        <item name="android:textColor">@color/data_downloader_main_text_color</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">@dimen/data_downloader_main_text_padding_left</item>
        <item name="android:paddingTop">@dimen/data_downloader_main_text_padding_top</item>
        <item name="android:paddingRight">@dimen/data_downloader_main_text_padding_right</item>
        <item name="android:paddingBottom">@dimen/data_downloader_main_text_padding_bottom</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="data_downloader_progress_text" parent="@style/data_downloader_progress_text_extra_style">
        <item name="android:textSize">@dimen/data_downloader_progress_text_size</item>
        <item name="android:textColor">@color/data_downloader_progress_text_color</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="data_downloader_progreeBar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_gravity">bottom|center_horizontal</item>
        <item name="android:layout_width">@dimen/data_downloader_horizontal_progessbar_width</item>
        <item name="android:layout_height">@dimen/data_downloader_horizontal_progessbar_height</item>
        <item name="android:indeterminate">false</item>
        <item name="android:progressDrawable">@drawable/data_downloader_progressbar</item>
    </style>
    <style name="data_downloader_progreeBar_spin" parent="@android:style/Widget.ProgressBar">
        <item name="android:layout_gravity">bottom|center_horizontal</item>
        <item name="android:padding">@dimen/data_downloader_progress_spin_padding</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="data_downloader_webview_style" parent="">
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">5dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">5dp</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginRight">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="gi_Widget.Button" parent="@android:style/Widget.Button">
        <item name="android:textSize">@dimen/gi_text_size</item>
        <item name="android:typeface">sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gi_button_text</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">15dp</item>
        <item name="android:paddingRight">15dp</item>
        <item name="android:focusable">false</item>
        <item name="android:layout_width">@dimen/gi_button_width</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:minWidth">@dimen/gi_button_width</item>
    </style>
    <style name="gi_Widget.ButtonSoftkey" parent="@android:style/Widget.Button">
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">15dp</item>
        <item name="android:paddingRight">15dp</item>
        <item name="android:focusable">false</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>
    <style name="gi_Widget.TextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">@dimen/gi_text_size</item>
        <item name="android:typeface">normal</item>
        <item name="android:textColor">@color/gi_info_text</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">@dimen/gi_textview_pading_lr</item>
        <item name="android:paddingRight">@dimen/gi_textview_pading_lr</item>
    </style>
    <style name="gi_Widget.TextViewTittle" parent="@android:style/Widget.TextView">
        <item name="android:textSize">@dimen/gi_text_tittle_size</item>
        <item name="android:typeface">sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gi_tittle_text</item>
        <item name="android:paddingLeft">@dimen/gi_textview_pading_lr</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingRight">@dimen/gi_textview_pading_lr</item>
        <item name="android:paddingBottom">1dp</item>
    </style>
    <style name="Theme.GameInstaller" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:buttonStyle">@style/gi_Widget.Button</item>
        <item name="android:textViewStyle">@style/gi_Widget.TextView</item>
    </style>
    <style name="Theme.GameInstallerNoBG" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:buttonStyle">@style/gi_Widget.Button</item>
        <item name="android:textViewStyle">@style/gi_Widget.TextView</item>
    </style>
</resources>
