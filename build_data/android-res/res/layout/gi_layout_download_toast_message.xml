<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/toast_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="@dimen/gi_notif_toast_sizeW"
        android:layout_height="@dimen/gi_notif_toast_sizeH"
        android:src="@drawable/data_downloader_toast_background"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/imageView1"
        android:padding="@dimen/gi_notif_toast_image_padding"
        android:layout_width="@dimen/gi_notif_toast_sizeH"
        android:layout_height="@dimen/gi_notif_toast_sizeH"
        android:src="@drawable/icon"
        android:scaleType="fitXY"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/gi_notif_toast_title_size"
        android:textStyle="bold"
        android:textColor="#ff000000"
        android:gravity="bottom|left"
        android:id="@+id/data_downloader_toast_title"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/gi_notif_toast_text_sizeH"
        android:text="@string/app_name"
        android:layout_alignLeft="@+id/data_downloader_toast_message"
        android:layout_alignRight="@+id/imageView2"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="@dimen/gi_notif_toast_text_size"
        android:textColor="#ff000000"
        android:gravity="top|left"
        android:id="@+id/data_downloader_toast_message"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/gi_notif_toast_text_sizeH"
        android:layout_toRightOf="@+id/imageView1"
        android:layout_below="@+id/data_downloader_toast_title"
        android:layout_alignRight="@+id/imageView2"/>
</RelativeLayout>
