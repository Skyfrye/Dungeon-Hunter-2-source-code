<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="left"
    android:orientation="vertical"
    android:id="@+id/LinearLayout01"
    android:background="#ffffffff"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/frameLayout1"
        android:background="#ff95c400"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:layout_gravity="left"
            android:id="@+id/txtTittle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="7dp"
            android:text="@string/app_name"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/frameLayout2"
            android:padding="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#ff000000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/textView1"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/linearLayout2"
            android:background="@drawable/iab_button_gradient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/iab_dialog_button_height">
            <Button
                android:textStyle="bold"
                android:id="@+id/OkButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/iab_dialog_button_height"
                android:minWidth="@dimen/iab_dialog_button_width"
                android:text="@string/IAB_SKB_OK"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
