<RootRule name="#deadends[0]">
	<Path name="#path" length="2,3" dontgoback=true>
		<ForceBlock name="#tmodules">
			<Path name="#path" length="2,3" dontgoback=true>
				<ForceBlock name="#objective_rooms[0]"/>
			</Path>
			<ForceBlock name="#deadends[1]"/>
		</ForceBlock>
	</Path>
</RootRule>
</rules>