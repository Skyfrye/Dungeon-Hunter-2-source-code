<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/swamp"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\022_swamp2.pyscript"
	camera_znear="900"
	camera_zfar="5000"
	music="SwampHubAmbientMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/swamp.lightset_xml"
	fixed_light_set="data/3D/Light/swamp_es_1_1.lightset_xml"
	prog_vertex_buffer_size="430776"
	prog_index_buffer_size="77538"
	fix_vertex_buffer_size="877392"
	fix_index_buffer_size="91068"
>
<!-- TEST -->
  <list name="start" random="true">
		<elem name="corner_ruin_wn_00" gameplay="swamp2_corner_ruin_wn_00.mgp" visual="swamp2_corner_ruin_wn_00.mvp"/>
	</list>

	<list name="deadends2" random="true">
		<elem name="deadend_brdwalk_w_00" gameplay="swamp2_deadend_brdwalk_w_00.mgp" visual="swamp2_deadend_brdwalk_w_00.mvp"/>
	</list>
	
	<list name="deadends3" random="true">
		<elem name="straight_brdwalk_ns_00" gameplay="swamp2_straight_brdwalk_ns_01.mgp" visual="swamp2_straight_brdwalk_ns_01.mvp"/>
	</list>

	<list name="tmodules" random="true">
		<elem name="obj_1of4_brdwalk_nse_00" gameplay="swamp2_obj_1of4_brdwalk_nse_00.mgp" visual="swamp2_obj1of4_brdwalk_nse_00.mvp"/>
	</list>
	
	<list name="path_road" random="true">
		<elem name="straight_brdwalk_we_00" gameplay="swamp2_straight_brdwalk_we_00.mgp" visual="swamp2_straight_brdwalk_we_00.mvp"/>
		<elem name="straight_brdwalk_ns_00" gameplay="swamp2_straight_brdwalk_ns_00.mgp" visual="swamp2_straight_brdwalk_ns_00.mvp"/> 
		<elem name="corner_ruin_wn_00" gameplay="swamp2_corner_ruin_wn_01.mgp" visual="swamp2_corner_ruin_wn_01.mvp"/>
		<elem name="corner_ruin_wn_00" gameplay="swamp2_corner_ruin_wn_02.mgp" visual="swamp2_corner_ruin_wn_01.mvp"/>
		<elem name="corner_ruin_se_00" gameplay="swamp2_corner_ruin_se_00.mgp" visual="swamp2_corner_ruin_se_00.mvp"/>
		<elem name="obj_2of4_brdwalk_sw_00" gameplay="swamp2_obj2of4_brdwalk_sw_00.mgp" visual="swamp2_obj2of4_brdwalk_sw_00.mvp"/>
		<elem name="corner_brdwalk_ne_00" gameplay="swamp2_corner_brdwalk_ne_00.mgp" visual="swamp2_corner_brdwalk_ne_00.mvp"/>
	</list>

<RootRule name="#start">
	<ForceBlock name="#path_road[0]">
		<Path name="#path_road" length="2,4" dontGoBack="true">
			<ForceBlock name="#tmodules">
				<ForceBlock name="#deadends2"/>
				<Path name="#path_road" length="2,4" dontGoBack="true">
					<ForceBlock name="#path_road[4]">
						<ForceBlock name="#deadends3">
							<EndPath exit="south"/>
						</ForceBlock>
					</ForceBlock>
				</Path>
			</ForceBlock>
		</Path>
	</ForceBlock>
	<EndPath exit="north"/>
</RootRule>
</rules>