<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/void_maze"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\033_voidmaze.pyscript"
	camera_znear="900"
	camera_zfar="5000"
	music="CatacombsMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
>

	<list name="deadends" random="true">
		<elem name="deadend_voidmaze_e_00" gameplay="vm01_deadend_voidmaze_e_00_01.mgp" visual="vm01_deadend_voidmaze_e_00_01.mvp"/>
		<elem name="deadend_voidmaze_n_01" gameplay="vm01_deadend_voidmaze_n_00_01.mgp" visual="vm01_deadend_voidmaze_n_00_01.mvp"/>
		<elem name="deadend_voidmaze_s_00" gameplay="vm01_deadend_voidmaze_s_00_01.mgp" visual="vm01_deadend_voidmaze_s_00_01.mvp"/>
		<elem name="deadend_voidmaze_w_00" gameplay="vm01_deadend_voidmaze_w_00_01.mgp" visual="vm01_deadend_voidmaze_w_00_01.mvp"/>
---
		<elem name="deadend_voidmaze_s_00" gameplay="vm01_deadend_voidmaze_s_00_02.mgp" visual="vm01_deadend_voidmaze_s_00_01.mvp"/>
		<elem name="deadend_voidmaze_n_01" gameplay="vm01_deadend_voidmaze_n_00_03.mgp" visual="vm01_deadend_voidmaze_n_00_03.mvp"/>		
	</list>
	
	<list name="tmodules" random="true">
		<elem name="t_voidmaze_nse_00" gameplay="vm01_t_voidmaze_nse_00_01.mgp" visual="vm01_t_voidmaze_nse_00_01.mvp"/>
		<elem name="t_voidmaze_nsw_00" gameplay="vm01_t_voidmaze_nsw_00_01.mgp" visual="vm01_t_voidmaze_nsw_00_01.mvp"/>
		<elem name="deadend_voidmaze_n_00" gameplay="vm01_deadend_voidmaze_n_00_01.mgp" visual="vm01_deadend_voidmaze_n_00_01.mvp"/>
	</list>

	<list name="objective_rooms" random="true">
		<elem name="assassin_voidmaze_s_00" gameplay="vm01_assassin_voidmaze_s_00_01.mgp" visual="vm01_assassin_voidmaze_s_00_01.mvp"/>
		<elem name="island_voidmaze_00" gameplay="vm01_island_voidmaze_00_01.mgp" visual="vm01_island_voidmaze_00_01.mvp"/>
		<elem name="x_voidmaze_nswe_00" gameplay="vm01_x_voidmaze_nswe_00.mgp" visual="vm01_x_voidmaze_nswe_00"/>
	</list>

	<list name="path" random="true">
		<elem name="corner_voidmaze_ne_00" gameplay="vm011_corner_voidmaze_ne_00_01.mgp" visual="vm01_corner_voidmaze_ne_00_01.mvp"/>
		<elem name="corner_voidmaze_se_00" gameplay="vm01_corner_voidmaze_se_00_01.mgp" visual="vm01_corner_voidmaze_se_00_01.mvp"/>
		<elem name="corner_voidmaze_nw_00" gameplay="vm01_corner_voidmaze_nw_00_01.mgp" visual="vm01_corner_voidmaze_nw_00_01.mvp"/>
		<elem name="corner_voidmaze_sw_00" gameplay="vm01_corner_voidmaze_sw_00_01.mgp" visual="vm01_corner_voidmaze_sw_00_01.mvp"/>
		<elem name="straight_voidmaze_ns_00" gameplay="vm01_straight_voidmaze_ns_00_01.mgp" visual="vm01_straight_voidmaze_ns_00_01.mvp"/>
		<elem name="straight_voidmaze_we_00" gameplay="vm01_straight_voidmaze_we_00_01.mgp" visual="vm01_straight_voidmaze_we_00_01.mvp"/>
	</list>

<!-- 
!!!DON'T FORGET!!!
assassin_voidmaze_s_00 is actually a NORTH/SOUTH module
island_voidmaze_00 is actually a NORTH/SOUTH module
deadend_voidmaze_n_00 is actually NORTH/SOUTH module
 -->

<RootRule name="#deadends[4]">
	<ForceBlock name="#tmodules[0]">
		<ForceBlock name="#deadends[3]"/>
		<Path name="#path" length="1" dontgoback=true>
				<ForceBlock name="#tmodules[1]">
					<ForceBlock name="#deadends[0]"/>
					<Path name="#path" length="1" dontgoback=true>
						<ForceBlock name="#path[4]">					
							<ForceBlock name="#tmodules[0]">
								<ForceBlock name="#deadends[3]"/>
								<ForceBlock name="#deadends[5]"/>
							</ForceBlock>
						</ForceBlock>
					</Path>
					</ForceBlock>
			</ForceBlock>
		</Path>
		</ForceBlock>
	</ForceBlock>
</RootRule>
</rules>