<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/crypt"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\009_abbey.pyscript"
	camera_znear="900"
	camera_zfar="100000"
	music="AbbeyRuinsOneAmbientMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/crypt.lightset_xml"
	fixed_light_set="data/3D/Light/crypt_es1_1.lightset_xml"
	prog_vertex_buffer_size="181368"
	prog_index_buffer_size="38916"
	fix_vertex_buffer_size="1034820"
	fix_index_buffer_size="85440"
>

	<list name="deadends" random="true">
		<elem name="deadend_e" gameplay="abbey_deadend_e_01.mgp" visual="abbey_deadend_e_01.mvp"/>
		<elem name="deadend_n" gameplay="abbey_deadend_n_01.mgp" visual="abbey_deadend_n_01.mvp"/>
		<elem name="deadend_w" gameplay="abbey_deadend_w_01.mgp" visual="abbey_deadend_w_01.mvp"/>
	</list>
	
	<list name="tmodules" random="true">
		<elem name="t_nse" gameplay="abbey_t_nse_01.mgp" visual="abbey_t_nse_01.mvp"/>
		<elem name="t_sew" gameplay="abbey_t_sew_01.mgp" visual="abbey_t_sew_01.mvp"/>		
	</list>

	<list name="start" random="true">
		<elem name="entrance_n" gameplay="ABBEY_entrance_n_01.mgp" visual="ABBEY_entrance_n_01.mvp"/>
	</list>
	
	<list name="end" random="true">
		<elem name="boss_room" gameplay="abbey_kings_chamber_s_01.mgp" visual="abbey_kings_chamber_s_01.mvp"/>
	</list>

	<list name="path" random="true">
		<elem name="corner_ne" gameplay="abbey_corner_ne_01.mgp" visual="abbey_corner_ne_01.mvp"/>
		<elem name="corner_nw" gameplay="abbey_corner_nw_01.mgp" visual="abbey_corner_nw_01.mvp"/>
		<elem name="corner_se" gameplay="abbey_corner_se_01.mgp" visual="abbey_corner_se_01.mvp"/>
		<elem name="corner_sw" gameplay="abbey_corner_sw_01.mgp" visual="abbey_corner_sw_01.mvp"/>
		<elem name="straight_a_ew" gameplay="abbey_straight_a_ew_01.mgp" visual="abbey_straight_a_ew_01.mvp"/>
		<elem name="straight_b_ew" gameplay="abbey_straight_b_ew_01.mgp" visual="abbey_straight_b_ew_01.mvp"/>
		<elem name="straight_c_ew" gameplay="abbey_straight_c_ew_01.mgp" visual="abbey_straight_c_ew_01.mvp"/>		
		<elem name="straight_d_ew" gameplay="abbey_straight_d_ew_01.mgp" visual="abbey_straight_d_ew_01.mvp"/>
		<elem name="straight_ns" gameplay="abbey_straight_ns_01.mgp" visual="abbey_straight_ns_01.mvp"/>
	</list>

<RootRule name="#start">
	<Path name="#path" length="1,2">
		<Forceblock name="#tmodules[1]">
			<Forceblock name="#deadends[0]"/>
			<Path name="#path" length="1,2">
				<Forceblock name="#tmodules[1]">
					<Forceblock name="#deadends[1]"/>
					<Path name="#path" length="1,2">
						<Forceblock name="#tmodules[0]">
							<Forceblock name="#end"/>
							<Forceblock name="#deadends[2]"/>
						</Forceblock>
					</Path>
				</Forceblock>
			</Path>
		</Forceblock>
	</Path>
</RootRule>
</rules>