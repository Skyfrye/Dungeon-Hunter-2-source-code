<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/crypt"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\PyData\scripts\007_CRYPT_01.pyscript"
	camera_znear="900"
	camera_zfar="5000"
	music="CatacombsMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
>

	<list name="deadends" random="true">
		<elem name="deadend_e" gameplay="questtest_deadend_e.mgp" visual=""/>
		<elem name="deadend_w" gameplay="questtest_deadend_w.mgp" visual=""/>
		<elem name="deadend_n" gameplay="questtest_deadend_n.mgp" visual=""/>
		<elem name="deadend_n" gameplay="questtest_deadend_n2.mgp" visual=""/>		
	</list>
	
	<list name="tmodules" random="true">
		<elem name="t_sew" gameplay="questtest_t_sew.mgp" visual=""/>
		<elem name="t_sew" gameplay="questtest_t_sew2.mgp" visual=""/>		
	</list>

	<list name="path" random="true">
		<elem name="straight_a_ew" gameplay="questtest_straight_a_ew.mgp" visual=""/>
	</list>

<RootRule name="#deadends[0]">
	<Forceblock name="#tmodules[0]">
		<ForceBlock name="#deadends[2]"/>
		<ForceBlock name="#path[0]">
			<ForceBlock name = "#tmodules[1]">
				<ForceBlock name = "#deadends[3]"/>
				<ForceBlock name = "#deadends[1]"/>
			</ForceBlock>			
		</Forceblock>
	</Forceblock>
</RootRule>
</rules>