<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/water_temple"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\023_watertemple_01.pyscript"
	camera_znear="900"
	camera_zfar="5000"
	music="WaterTempleCaveAmbientMusic"
	ambiant_music="sfx_water_temple_ambiance"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/watertemple.lightset_xml"
	fixed_light_set="data/3D/Light/watertemple_es1_1.lightset_xml"
	prog_vertex_buffer_size="280800"
	prog_index_buffer_size="35100"
	fix_vertex_buffer_size="1669068"
	fix_index_buffer_size="149814"
>

	<list name="deadends" random="true">
		<elem name="deadend_watertemp_e_00" gameplay="watertemple_deadend_e_01.mgp" visual="watertemple_deadend_e_01.mvp"/>
		<elem name="deadend_watertemp_w_00" gameplay="watertemple_deadend_w_01.mgp" visual="watertemple_deadend_w_00.mvp"/>
		<elem name="deadend_watertemp_w_00" gameplay="watertemple_deadend_w_02.mgp" visual="watertemple_deadend_w_00.mvp"/>
		<elem name="deadend_watertemp_n_00" gameplay="watertemple_deadend_n_01.mgp" visual="watertemple_deadend_n_01.mvp"/>
		<elem name="deadend_watertemp_n_00" gameplay="watertemple_deadend_n_02.mgp" visual="watertemple_deadend_n_01.mvp"/>
		<elem name="deadend_watertemp_s_00" gameplay="watertemple_deadend_s_01.mgp" visual="watertemple_deadend_s_01.mvp"/>
	</list>

	<list name="tmodules" random="true">
		<elem name="t_watertemp_wse_00" gameplay="watertemple_t_wse_01.mgp" visual="watertemple_t_wse_01.mvp"/>
		<elem name="t_watertemp_nsw_00" gameplay="watertemple_t_nsw_01.mgp" visual="watertemple_t_nsw_01.mvp"/>
		<elem name="t_watertemp_nsw_00" gameplay="watertemple_t_nsw_02.mgp" visual="watertemple_t_nsw_01.mvp"/>		
	</list>

	<list name="end" random="true">
		<elem name="objend_watertemp_s_00" gameplay="watertemple_deadend_objend_s_01.mgp" visual="watertemple_deadend_objend_s_01.mvp"/>
	</list>

	<list name="objective_rooms" random="true">
		<elem name="objmid_watertemp_ns_00" gameplay="watertemple_straight_objmid_ns_01.mgp" visual="watertemple_straight_objmid_ns_01.mvp"/>
		<elem name="t_watertemp_wse_00" gameplay="watertemple_t_wse_02.mgp" visual="watertemple_t_wse_01.mvp"/>
	</list>

	<list name="start" random="true">
		<elem name="objstart_watertemp_s_00" gameplay="watertemple_deadend_objstart_w_01.mgp" visual="watertemple_deadend_objstart_w_01.mvp"/>
	</list>

	<list name="path" random="true">
		<elem name="corner_watertemp_se_00" gameplay="watertemple_corner_se_01.mgp" visual="corner_watertemp_se_01.mvp"/>
		<elem name="corner_watertemp_ne_00" gameplay="watertemple_corner_ne_01.mgp" visual="watertemple_corner_ne_01.mvp"/>
		<elem name="corner_watertemp_wn_00" gameplay="watertemple_corner_wn_03.mgp" visual="watertemple_corner_wn_01.mvp"/>
		<elem name="corner_watertemp_sw_00" gameplay="watertemple_corner_sw_03.mgp" visual="watertemple_corner_sw_01.mvp"/>
		<elem name="straight_watertemp_ew_00" gameplay="watertemple_straight_ew_01.mgp" visual="watertemple_straight_ew_01.mvp"/>
	</list>

	<list name="randpath" random="true">
		<elem name="corner_watertemp_ne_00" gameplay="watertemple_corner_ne_02.mgp" visual="watertemple_corner_ne_01.mvp"/>
		<elem name="corner_watertemp_ne_00" gameplay="watertemple_corner_ne_03.mgp" visual="watertemple_corner_ne_01.mvp"/>
		<elem name="corner_watertemp_ne_00" gameplay="watertemple_corner_ne_04.mgp" visual="watertemple_corner_ne_01.mvp"/>
		<elem name="corner_watertemp_wn_00" gameplay="watertemple_corner_wn_01.mgp" visual="watertemple_corner_wn_01.mvp"/>
		<elem name="corner_watertemp_wn_00" gameplay="watertemple_corner_wn_02.mgp" visual="watertemple_corner_wn_01.mvp"/>
		<elem name="corner_watertemp_sw_00" gameplay="watertemple_corner_sw_01.mgp" visual="watertemple_corner_sw_01.mvp"/>
		<elem name="corner_watertemp_sw_00" gameplay="watertemple_corner_sw_02.mgp" visual="watertemple_corner_sw_01.mvp"/>
		<elem name="straight_watertemp_ew_00" gameplay="watertemple_straight_ew_01.mgp" visual="watertemple_straight_ew_01.mvp"/>
		<elem name="straight_watertemp_ew_00" gameplay="watertemple_straight_ew_02.mgp" visual="watertemple_straight_ew_01.mvp"/>
		<elem name="straight_watertemp_ns_00" gameplay="watertemple_straight_ns_01.mgp" visual="watertemple_straight_ns_01.mvp"/>
		<elem name="straight_watertemp_ns_00" gameplay="watertemple_straight_ns_02.mgp" visual="watertemple_straight_ns_01.mvp"/>
		<elem name="straight_watertemp_ns_00" gameplay="watertemple_straight_ns_03.mgp" visual="watertemple_straight_ns_01.mvp"/>
		<elem name="straight_watertemp_ns_00" gameplay="watertemple_straight_ns_04.mgp" visual="watertemple_straight_ns_01.mvp"/>
		<elem name="straight_watertemp_ns_00" gameplay="watertemple_straight_ns_05.mgp" visual="watertemple_straight_ns_01.mvp"/>
		<elem name="corner_watertemp_ne_00" gameplay="watertemple_corner_ne_02.mgp" visual="watertemple_corner_ne_01.mvp"/>
		<elem name="corner_watertemp_ne_00" gameplay="watertemple_corner_ne_03.mgp" visual="watertemple_corner_ne_01.mvp"/>
	</list>

<RootRule name="#start">
	<Path name="#randpath" length="3" dontgoback=true>
		<ForceBlock name="#tmodules">
			<ForceBlock name="#objective_rooms[0]">		
				<ForceBlock name="#objective_rooms[1]">
					<Path name="#randpath" length="3" dontgoback=true>
						<ForceBlock name="#end"/>
					</Path>
					<ForceBlock name="#deadends"/>
				</ForceBlock>
			</ForceBlock>				
			<ForceBlock name="#deadends"/>
		</ForceBlock>
	</Path>
</RootRule>
</rules>