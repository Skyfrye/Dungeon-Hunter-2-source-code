<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/castle"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\010_elemental_lightning_room.pyscript"
	camera_znear="900"
	camera_zfar="5000"
	music="LightTowerAmbientMusic"
	combat_music="LightTowerCombatMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/castle.lightset_xml"
>

	<list name="deadends" random="true">
		<elem name="deadend_n" gameplay="el_lightning_deadend_n_01.mgp" visual="elemental_deadend_startroom.mvp"/>
	</list>

	<list name="objective_rooms" random="true">
		<elem name="objectiveroom_s" gameplay="boss_lightning.mgp" visual="elemental_objectiveroom_s_01.mvp"/>
	</list>

	<list name="path" random="true">
		<elem name="corner_ne" gameplay="" visual="elemental_corner_ne_01.mvp"/>
		<elem name="corner_wn" gameplay="" visual="elemental_corner_wn_01.mvp"/>
		<elem name="corner_ws" gameplay="" visual="elemental_corner_ws_01.mvp"/>
		<elem name="corner_se" gameplay="" visual="elemental_corner_se_01.mvp"/>
		<elem name="straighta_ns" gameplay="" visual="elemental_straighta_ns_01.mvp"/>
		<elem name="straightb_ew" gameplay="" visual="elemental_straightb_ew_01.mvp"/>
	</list>

<RootRule name="#deadends[0]">
	<Path name="#path" length="3,4" dontgoback=true>
		<ForceBlock name="#objective_rooms"/>			
	</Path>
</RootRule>
</rules>