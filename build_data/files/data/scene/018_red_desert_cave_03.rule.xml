<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/desert_cave"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\PyData\scripts\018_RED_DESERT_CAVE_03.pyscript"
	camera_znear="900"
	camera_zfar="10000"
	music="RedDesertThreeAmbientMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/desertcave.lightset_xml"
	fixed_light_set="data/3D/Light/desertcave_es1_1.lightset_xml"
	prog_vertex_buffer_size="59472"
	prog_index_buffer_size="24822"
	fix_vertex_buffer_size="896184"
	fix_index_buffer_size="123270"
>

	<list name="deadends" random="true">
		<elem name="deadend_dsrtcave_e_00" gameplay="rdc03_deadend_dsrtcave_e_00_01.mgp" visual="rdc03_corner_dsrtcave_ne_00_01.mvp"/>
		<elem name="deadend_dsrtcave_n_00" gameplay="rdc03_corner_dsrtcave_se_00_01.mgp" visual="rdc03_corner_dsrtcave_se_00_01.mvp"/>
		<elem name="deadend_dsrtcave_s_00" gameplay="rdc03_corner_dsrtcave_wn_00_01.mgp" visual="rdc03_corner_dsrtcave_wn_00_01.mvp"/>
		<elem name="deadend_dsrtcave_w_00" gameplay="rdc03_corner_dsrtcave_ws_00_01.mgp" visual="rdc03_corner_dsrtcave_ws_00_01.mvp"/>
	</list>

	<list name="tmodules" random="true">
		<elem name="t_dsrtcave_nsw_00" gameplay="rdc03_t_dsrtcave_nsw_00_01.mgp" visual="rdc03_t_dsrtcave_nsw_00_01.mvp"/>
	</list>

	<list name="objectives" random="true" replacement="false">
		<elem name="obj03_dsrtcave_ns_00" gameplay="rdc03_obj03_dsrtcave_ns_00_01.mgp" visual="rdc03_obj03_dsrtcave_ns_00_01.mvp"/>
		<elem name="corner_dsrtcave_ws_00" gameplay="rdc03_corner_obj_dsrtcave_ws_00_01.mgp" visual="rdc03_corner_obj_dsrtcave_ws_00_01.mvp"/>
	</list>

	<list name="path" random="true">
		<elem name="corner_dsrtcave_ne_00" gameplay="rdc03_corner_dsrtcave_ne_00_01.mgp" visual="rdc03_corner_dsrtcave_ne_00_01.mvp"/>
		<elem name="corner_dsrtcave_se_00" gameplay="rdc03_corner_dsrtcave_se_00_01.mgp" visual="rdc03_corner_dsrtcave_se_00_01.mvp"/>
		<elem name="corner_dsrtcave_wn_00" gameplay="rdc03_corner_dsrtcave_wn_00_01.mgp" visual="rdc03_corner_dsrtcave_wn_00_01.mvp"/>
		<elem name="corner_dsrtcave_ws_00" gameplay="rdc03_corner_dsrtcave_ws_00_01.mgp" visual="rdc03_corner_dsrtcave_ws_00_01.mvp"/>
		<elem name="straight_dsrtcave_we_00" gameplay="rdc03_straight_dsrtcave_we_00_01.mgp" visual="rdc03_straight_dsrtcave_we_00_01.mvp"/>
	</list>

	<list name="start" random="true">
		<elem name="deadend_dsrtcave_n_00" gameplay="rdc03_objentrance_dsrtcave_n_00_01.mgp" visual="rdc03_objentrance_dsrtcave_n_00_01.mvp"/>
	</list>
	
	<list name="end" random="true">
		<elem name="deadend_dsrtcave_s_00" gameplay="rdc03_objexit_dsrtcave_s_00_01.mgp" visual="rdc03_objexit_dsrtcave_s_00_01.mvp"/>
	</list>
	
<RootRule name="#start">
	<Forceblock name="#tmodules[0]">
		<Forceblock name="#objectives[1]">
			<path name="#path" length="2,4" dontGoBack="true">
				<Forceblock name="#objectives[0]">
					<Forceblock name="#end"/>
				</Forceblock>
			</path>
		</Forceblock>
		<path name="#path" length="1,2" dontGoBack="true">
			<Forceblock name="#deadends[0]"/>
		</path>
	</Forceblock>
</RootRule>
</rules>