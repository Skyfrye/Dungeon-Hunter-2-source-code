<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/root_den"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\004_root_den.pyscript"
	camera_znear="900"
	camera_zfar="10000"
	music="RootDenOneAmbientMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/rootden.lightset_xml"
	fixed_light_set="data/3D/Light/rootden_es1_1.lightset_xml"
	prog_vertex_buffer_size="227376"
	prog_index_buffer_size="56610"
	fix_vertex_buffer_size="1012428"
	fix_index_buffer_size="103170"
>

	<list name="deadends" random="true">
		<elem name="deadend_rootden_e_" gameplay="deadend_rootden_e__01.mgp" visual="deadend_rootden_e__01.mvp"/>
		<elem name="deadend_rootden_n_" gameplay="" visual="deadend_rootden_n__01.mvp"/>
		<elem name="deadend_rootden_s_" gameplay="" visual="deadend_rootden_s__01.mvp"/>
		<elem name="deadend_rootden_w_" gameplay="deadend_rootden_w__01.mgp" visual="deadend_rootden_w__01.mvp"/>
	</list>

	<list name="tmodules" random="true">
		<elem name="t_rootden_esw_" gameplay="" visual="t_rootden_esw__01.mvp"/>
		<elem name="t_rootden_wne_" gameplay="" visual="t_rootden_wne__01.mvp"/>
	</list>

	<list name="objectives" random="true">
		<elem name="objboss_rootden_w_" gameplay="objboss_rootden_w__01.mgp" visual="objboss_rootden_w__01.mvp"/>
		<elem name="objcross_rootden_nesw_" gameplay="objcross_rootden_nesw__01.mgp" visual="objcross_rootden_nesw__01.mvp"/>
		<elem name="objentry_rootden_e_" gameplay="objentry_rootden_e__01.mgp" visual="objentry_rootden_e__01.mvp"/>
	</list>

	<list name="path_cave" random="true">
		<elem name="corner_rootden_ne_" gameplay="" visual="corner_rootden_ne__01.mvp"/>
		<elem name="corner_rootden_nw_" gameplay="corner_rootden_nw__01.mgp" visual="corner_rootden_nw__01.mvp"/>
		<elem name="corner_rootden_se_" gameplay="corner_rootden_se__01.mgp" visual="corner_rootden_se__01.mvp"/>
		<elem name="corner_rootden_sw_" gameplay="" visual="corner_rootden_sw__01.mvp"/>
		<elem name="straight_rootden_ew_" gameplay="" visual="straight_rootden_ew__01.mvp"/>
		<elem name="straight_rootden_ns_" gameplay="straight_rootden_ns__01.mgp" visual="straight_rootden_ns__01.mvp"/>
	</list>

<RootRule name="#objectives[2]">
	<ForceBlock name="#path_cave[1]">
		<ForceBlock name="#path_cave[5]">
			<ForceBlock name="#objectives[1]">
				<ForceBlock name="#deadends[0]"/>
				<ForceBlock name="#deadends[3]"/>
				<ForceBlock name="#path_cave[2]">
					<ForceBlock name="#objectives[0]"/>
				</Forceblock>
			</Forceblock>
		</ForceBlock>
	</ForceBlock>
</RootRule>
</rules>