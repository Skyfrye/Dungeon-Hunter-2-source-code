<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/castle"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\010_elemental_lightning_room.pyscript"
	camera_znear="900"
	camera_zfar="5000"
	music="LightTowerAmbientMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/castle.lightset_xml"
	fixed_light_set="data/3D/Light/castle_es1_1.lightset_xml"
	prog_vertex_buffer_size="301104"
	prog_index_buffer_size="58056"
	fix_vertex_buffer_size="1719468"
	fix_index_buffer_size="100158"
>

	<list name="deadends" random="true">
		<elem name="deadend_n" gameplay="el_lightning_deadend_n_01.mgp" visual="elemental_deadend_n_01.mvp"/>
		<elem name="deadend_w" gameplay="el_lightning_deadend_w_01.mgp" visual="elemental_deadend_w_01.mvp"/>
	</list>
	
	<list name="tmodules" random="true">
		<elem name="t_new" gameplay="el_lightning_t_new_01.mgp" visual="elemental_t_new_01.mvp"/>
	</list>

	<list name="objective_rooms" random="true">
		<elem name="objectiveroom_s" gameplay="boss_lightning.mgp" visual="elemental_objectiveroom_s_01.mvp"/>
	</list>

	<list name="path" random="true">
		<elem name="corner_ne" gameplay="el_lightning_corner_ne_01.mgp" visual="elemental_corner_ne_01.mvp"/>
		<elem name="corner_wn" gameplay="el_lightning_corner_wn_01.mgp" visual="elemental_corner_wn_01.mvp"/>
		<elem name="corner_ws" gameplay="el_lightning_corner_ws_01.mgp" visual="elemental_corner_ws_01.mvp"/>
		<elem name="corner_se" gameplay="el_lightning_corner_se_01.mgp" visual="elemental_corner_se_01.mvp"/>
		<elem name="straighta_ns" gameplay="el_lightning_straighta_ns_01.mgp" visual="elemental_straighta_ns_01.mvp"/>
		<elem name="straightb_ew" gameplay="el_lightning_straightb_ew_01.mgp" visual="elemental_straightb_ew_01.mvp"/>
	</list>

<RootRule name="#deadends[0]">
	<Path name="#path" length="3,4" dontgoback=true>
		<ForceBlock name="#tmodules">
			<ForceBlock name="#objective_rooms[0]"/>
			<ForceBlock name="#deadends[1]"/>			
		</ForceBlock>
	</Path>
</RootRule>
</rules>