<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT:   Folder is now a attribute of rules instead of RootRule -->
<!-- target now needs to be specified to be able to load in max -->
<rules
	target="iphone"
	folder="data/3d/modules/desert_cave"
	ambientColor="0.5,0.5,0.5"
	scriptFile="data\pydata\scripts\017_red_desert_cave_02.pyscript"
	camera_znear="900"
	camera_zfar="10000"
	music="RedDesertCaveTwoAmbientMusic"
	fog_start="4000"
	fog_end="5800"
	fog_color="1.14,0.36,0.49"
	light_set="data/3D/Light/desertcave.lightset_xml"
	fixed_light_set="data/3D/Light/desertcave_es1_1.lightset_xml"
	prog_vertex_buffer_size="229272"
	prog_index_buffer_size="69816"
	fix_vertex_buffer_size="910188"
	fix_index_buffer_size="122262"
>

	<list name="deadends" random="true">
		<elem name="deadend_dsrtcave_s_00" gameplay="rdc02_deadend_dsrtcave_s_00_01.mgp" visual="rdc02_deadend_dsrtcave_s_00_01.mvp"/>
		<elem name="deadend_dsrtcave_s_00" gameplay="rdc02_deadend_dsrtcave_s_00_01.mgp" visual="rdc02_deadend_dsrtcave_s_00_01.mvp"/>
		<elem name="deadend_dsrtcave_s_00" gameplay="rdc02_deadend_dsrtcave_s_00_01.mgp" visual="rdc02_deadend_dsrtcave_s_00_01.mvp"/>
		<elem name="deadend_dsrtcave_s_00" gameplay="rdc02_deadend_dsrtcave_merchant_s_00_01.mgp" visual="rdc02_deadend_dsrtcave_s_00_01.mvp"/>
	</list>

	<list name="tmodules" random="true">
		<elem name="t_dsrtcave_nse_00" gameplay="rdc02_t_dsrtcave_nse_00_01.mgp" visual="rdc02_t_dsrtcave_nse_00_01.mvp"/>
	</list>

	<list name="path" random="true">
		<elem name="corner_dsrtcave_ne_00" gameplay="rdc02_corner_dsrtcave_ne_00_01.mgp" visual="rdc02_corner_dsrtcave_ne_00_01.mvp"/>
		<elem name="corner_dsrtcave_se_00" gameplay="rdc02_corner_dsrtcave_se_00_01.mgp" visual="rdc02_corner_dsrtcave_se_00_01.mvp"/>
		<elem name="corner_dsrtcave_wn_00" gameplay="rdc02_corner_dsrtcave_wn_00_01.mgp" visual="rdc02_corner_dsrtcave_wn_00_01.mvp"/>
		<elem name="corner_dsrtcave_ws_00" gameplay="rdc02_corner_dsrtcave_ws_00_01.mgp" visual="rdc02_corner_dsrtcave_ws_00_01.mvp"/>
	</list>
	
	<list name="wormbattle" random="true">
		<elem name="straight_dsrtcave_we_00" gameplay="rdc02_straight_dsrtcave_we_00_01.mgp" visual="rdc02_straight_dsrtcave_we_00_01.mvp"/>
	</list>

	<list name="start" random="true">
		<elem name="deadend_dsrtcave_n_00" gameplay="rdc02_objentrance_dsrtcave_n_00_01.mgp" visual="rdc02_objentrance_dsrtcave_n_00_01.mvp"/>
	</list>
	
	<list name="end" random="true">
		<elem name="obj05_dsrtcave_n_00" gameplay="rdc02_obj05_dsrtcave_n_00_01.mgp" visual="rdc02_obj05_dsrtcave_n_00_01.mvp"/>
	</list>
	
<RootRule name="#start">
	<Forceblock name="#tmodules[0]">
		<Forceblock name="#deadends[0]"/>
		<Path name="#path" length="2,4" dontGoBack="true">
			<Forceblock name="#wormbattle">
				<Path name="#path" length="2,4" dontGoBack="true">
					<Forceblock name="#end"/>
				</Path>
			</Forceblock>
		</Path>
	</Forceblock>
</RootRule>
</rules>