--[[	Trap Example Script

	Example of what a trap script would looks like.

--]]

local g_counter		= 0;
local COUNTER_DELAY	= 5;
local TIMERTRAP_DAM_ID	= GetPyOID("GameObjectDamager", "Level01Damage"); 

function OnTrigger(actor)
	return true;
end


function OnDamageRoll(victim)
	Trace("BLOUPS");
	DealDamages(victim, GetPyOID("GameObjectDamager", "Level01Damage"), GetPyCst("Elemental", "Water"));
end

function OnAnimEvent(event)
	if (event == "inccounter") then
		if (g_counter >= COUNTER_DELAY) then
			Remove();
		else
			g_counter = g_counter + 1;
		end
	end
end