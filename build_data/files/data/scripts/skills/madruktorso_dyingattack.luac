local function OnSkillCheck_()
	return true;
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()

end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()
	PlayFX(GetPyOID("AnimatedEffectTable", "fx_swampking_blue_shockwave"));
end

