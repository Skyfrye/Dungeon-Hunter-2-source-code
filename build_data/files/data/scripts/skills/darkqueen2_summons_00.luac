--[[	Rise

	revive a fallen foe that will fight on your side for a short duration 
	Time to respawn after death: 2 sec
	Duration before redeath: 10 sec
	Max of  allies: 2
	Cool down: na
	Cast time: na
	Mana Cost: 15
	
	This could be set as a buff.
	Need to find a way to summon monsters with the right alignment. no solution atm

--]]


-- ----------------------------------------------------------------------------------------------
-- DATA
-- ----------------------------------------------------------------------------------------------
-- Constants
local MOVE_RANGE	= 500.0;		-- Teleportation range
local RANGE			= 500.0;		-- Explosion radius
local ANGLE			= 360.0;		-- Explosion area
local RISEN			= {};			-- The risen gameobject
local count			= 0;			-- number of risen zombies
local bufftime 	= 10000		-- duration of the effect on the dead

local RISE_FX	= GetPyOID("AnimatedEffectTable", "MadrukFaeries_Spawn");
local CLASS_ID			= GetPyOID("ClassTable", "Skill_Necromancer_Rise");

-- Cached values
local skill_level = 0;
local mana_cost;
local traces		= false;

-- ----------------------------------------------------------------------------------------------
-- FUNCTIONS
-- ----------------------------------------------------------------------------------------------

local function checkslot()
	local slot = 0;
	if (RISEN[1]==nil) then
		if (traces) then Trace ("Slot 1 empty..."); end
		slot=1; return slot;
	end
	if (RISEN[2]==nil) then
		if (traces) then Trace ("Slot2 empty..."); end
		slot=2; return slot;
	end
	if (RISEN[1]~=nil) then
		if (RISEN[1]:IsDead()) then
			if (traces) then Trace ("Slot 1 empty..."); end
			RISEN[1]:UNLOCK();
			slot=1; 
			RISEN[1]=nil;
			return slot;
		end
	end
	if (RISEN[2]~=nil) then
		if (RISEN[2]:IsDead()) then
			if (traces) then Trace ("Slot2 empty..."); end
			RISEN[2]:UNLOCK();
			slot=2; 
			RISEN[2]=nil;
			return slot;
		end
	end
	return -1;
end

local function DoRise(slot)
	-- Hack to validate the path... if it doesn't work, we will have to add a method in PFWorld
	-- Trying moving forward
	-- If the path is good then the risen can walk up to the player and the ennemies
	--if (RISEN[slot]==nil) then
		MoveTo(0.0, MOVE_RANGE, 0.0, true);
		if(HasPath()) then
			RISEN[slot] = Summon(GetPyOID("CharacterTable", "DarkQueenMinion"),false, 0, MOVE_RANGE, 0, true);
			RISEN[slot]:LOCK();
			RISEN[slot]:PlayFX(RISE_FX);
			if (traces) then Trace("Yes, I can rise in the front!"); end
		else -- Trying backward
			MoveTo(0.0, -MOVE_RANGE, 0.0, true);
			if(HasPath()) then
				RISEN[slot] = Summon(GetPyOID("CharacterTable", "DarkQueenMinion"),false, 0, -MOVE_RANGE, 0, true);
				RISEN[slot]:LOCK();
				RISEN[slot]:PlayFX(RISE_FX);
				if (traces) then Trace("Yes, I can rise in the back!"); end
			else -- Trying right
			MoveTo(MOVE_RANGE, 0.0, 0.0, true);
				if(HasPath()) then
					RISEN[slot] = Summon(GetPyOID("CharacterTable", "DarkQueenMinion"),false, MOVE_RANGE, 0, 0, true);
					RISEN[slot]:LOCK();
					RISEN[slot]:PlayFX(RISE_FX);
					if (traces) then Trace("Yes, I can rise to the right!"); end
				else -- Trying left
					MoveTo(-MOVE_RANGE, 0.0, 0.0, true);
					if(HasPath()) then
						RISEN[slot] = Summon(GetPyOID("CharacterTable", "DarkQueenMinion"),false, -MOVE_RANGE, 0.0, 0.0, true);
						RISEN[slot]:LOCK();
						RISEN[slot]:PlayFX(RISE_FX);
						if (traces) then Trace("Yes, I can rise to the left!"); end
					end
				end
			end
		end
	--end
end
-- ----------------------------------------------------------------------------------------------
-- CALLBACKS
-- ----------------------------------------------------------------------------------------------
-- ----------------------------------------------------------------------------------------------
local function OnSkillInfo_(slvl)

end

-- ----------------------------------------------------------------------------------------------
local function OnSkillUpdate_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillCheck_()
	return true;
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()
	if (traces) then Trace("Queen is summoning!!!"); end
	count=checkslot();
	if (traces) then Trace("Here is the slot:"..count); end
	if (count~=-1) then
		DoRise(count);
	end
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillCleanUp_()
	if (RISEN[1]~=nil) then
		RISEN[1]:Kill();
		RISEN[1]:UNLOCK();
		RISEN[1]=nil;
		
	end
	if (RISEN[2]~=nil) then
		RISEN[2]:Kill();
		RISEN[2]:UNLOCK();
		RISEN[2]=nil;
	end
end
-- ----------------------------------------------------------------------------------------------
-- RegisterSkill(OnSkillUpdate_, OnSkillCheck_, OnPreSkill_, OnSkill_, OnPostSkill_, nil, OnSkillInfo_);
RegisterSkillEx({	update=OnSkillUpdate_,
					cleanup=OnSkillCleanUp_,
					check=OnSkillCheck_,
					pre=OnPreSkill_,
					skill=OnSkill_,
					info=OnSkillInfo_,
					});