--[[	Carrion Eater (Passive)

	Receive a small amount of HP for each kill
	HP Drained: 5/kill

--]]

local CLASS_ID			= GetPyOID("ClassTable", "Skill_Necromancer_CarrionEater");

-- Cached values
local skill_level		= 0;
local regenHP_amount;			-- Contain the TempProp1 value for the number of HP per kill.
local traces			= false;
-- ----------------------------------------------------------------------------------------------
-- ----------------------------------------------------------------------------------------------
local function OnTargetHit_Skill(attacker, defender)
	if (skill_level > 0) then
		if (attacker:GetID() == GetID()) then
			if (defender:IsDead()) then
				SetProp(GetPyStruct("CharacterProperties", "SnS_Level"), ToFixed(skill_level));
				ApplyPropClass(CLASS_ID);
				if (traces) then Trace("[Skills/Carrion Eater]The ennemy has been killed. Gimme the reward! "..regenHP_amount.." HP!"); end
				local hp, max_hp, hp_percent = GetHP();
				if ((hp+regenHP_amount)<max_hp) then
					max_hp = hp+regenHP_amount;
				end
				SetProp(GetPyStruct("CharacterProperties", "HP"),ToFixed(max_hp));
				local hp2, max_hp2, hp_percent2 = GetHP();
				if (hp2==hp) then
					RegenHP(regenHP_amount);
				end
				-- For some reason, RegenHP did not work (did not see the health meter increased)
				-- Used another method and tested
			end
		end
	end
end
StealAIEvent("OnTargetHit", OnTargetHit_Skill)
-- ----------------------------------------------------------------------------------------------
local function OnSkillInfo_(slvl)
	SetTempProps(CLASS_ID, slvl);
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillUpdate_()
	local slvl = GetCurrentSkillInfo();

	if(slvl ~= skill_level) then
		skill_level	= slvl;
	end
	SetProp(GetPyStruct("CharacterProperties", "SnS_Level"), ToFixed(skill_level));
	mana_cost	= CalcManaCost(CLASS_ID, slvl);
	regenHP_amount = FromFixed(GetProp(GetPyStruct("CharacterProperties", "TempProp1"), true));
end

local function OnSkillCheck_()
	return false, true;
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()
end

-- ----------------------------------------------------------------------------------------------
local function OnPostSkill_()
end

-- ----------------------------------------------------------------------------------------------
RegisterSkill(OnSkillUpdate_, OnSkillCheck_, OnPreSkill_, OnSkill_, OnPostSkill_, nil, OnSkillInfo_);