--[[	Find Weakness

	increases the rogue chance to score critical hit with daggers and ranged
	weapons.
	+2% critical hit chance	|	+2% critical hit chance

--]]

local CLASS_ID		= GetPyOID("ClassTable", "Skill_Rogue_FindWeakness");

-- Cached values
local skill_level	= 0;
local buff			= nil;
local traces 		= false;

local function OnSkillInfo_(slvl)
	SetTempProps(CLASS_ID, slvl);
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillUpdate_()
	local slvl = GetCurrentSkillInfo();
	if (traces) then Trace("Skill level is now level "..slvl); end
	if(slvl ~= skill_level) then
		skill_level = slvl;
	end
	SetProp(GetPyStruct("CharacterProperties", "SnS_Level"), ToFixed(skill_level));
	if (buff) then
		RemoveBuff(CLASS_ID, buff);
	end
	if (slvl~=0) then 
		buff = CreateBuff(CLASS_ID, 0, false, slvl);
		ApplyBuff(CLASS_ID, buff);
	end
end

local function OnSkillCheck_()
	return false, true;
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()
end

-- ----------------------------------------------------------------------------------------------
local function OnPostSkill_()
end

-- ----------------------------------------------------------------------------------------------
RegisterSkill(OnSkillUpdate_, OnSkillCheck_, OnPreSkill_, OnSkill_, OnPostSkill_, nil, OnSkillInfo_);