-- ----------------------------------------------------------------------------------------------------
-- Madruk Torso BeamRay Skill: 
-- 
-- - Frontal ranged attack.
-- ----------------------------------------------------------------------------------------------------


-- ----------------------------------------------------------------------------------------------
-- DATA
-- ----------------------------------------------------------------------------------------------
-- Constants
local RANGE 			= FromFixed(GetProp(GetPyStruct("CharacterProperties", "RangeMaxDistance")));
local ANGLE				= 75.0;

local CLASS_ID			= GetPyOID("ClassTable", "MadrukTorso_BeamRay");
local MADRUK_LASER_PROJECTILE_ID	= GetPyOID("ProjectileTable", "MadrukSlowEnergyBolt");


-- ----------------------------------------------------------------------------------------------
-- CALLBACKS
-- ----------------------------------------------------------------------------------------------
local function OnSkillInfo_(slvl)
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillUpdate_()
end

-- ----------------------------------------------------------------------------------------------
local function OnSkillCheck_()
	return true, false;
end

-- ----------------------------------------------------------------------------------------------
local function OnPreSkill_()
	SetTargetListCharacterFilter(GetPyCst("AITargetList_CharacterFilter", "Player"));
	SetTargetListObjectFilter(GetPyCst("AITargetList_ObjectFilter", "NONE"));
	SetTargetListSorting(GetPyCst("AITargetList_Sorting", "FrontalFirst"));

	TargetListSearch(RANGE);

	if(not IsTargetListEmpty()) then
		target = GetTargetListTop();
		LookAt(target);
	else
		target = nil;
	end
end

-- ----------------------------------------------------------------------------------------------
local function OnSkill_()
	TargetListSearch(RANGE, ANGLE, 0, 0, 0, true);
  	if(not IsTargetListEmpty()) then
		repeat
			local target,_,_, character = GetTargetListTop();
			-- Too efficient to look at the target while firing. Don't give a chance to the player
			--LookAt(target);
			local dmg = SkillCombatRoll(target);
			if (dmg == nil) then 
				dmg = 0;
			end
			if(character) and (dmg > 0) then
				target:PlayFX(GetPyOID("AnimatedEffectTable", "Madruk_Torso_laser_hurt"));
			end
			
			PopTargetList();
		until(IsTargetListEmpty())
	end
end

-- ----------------------------------------------------------------------------------------------
local function OnPostSkill_()
end

-- ----------------------------------------------------------------------------------------------
RegisterSkill(OnSkillUpdate_, OnSkillCheck_, OnPreSkill_, OnSkill_, OnPostSkill_, nil, OnSkillInfo_);